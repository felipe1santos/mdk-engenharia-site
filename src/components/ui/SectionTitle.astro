---
/**
 * Cabecalho padrao de secao: sobretitulo, titulo e subtitulo opcional.
 * Centraliza a hierarquia tipografica para que todas as secoes fiquem coerentes
 * e o nivel de heading seja explicito (o H1 pertence apenas ao hero).
 */
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  tone?: 'dark' | 'light';
  as?: 'h2' | 'h3';
  class?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  align = 'center',
  tone = 'dark',
  as: Tag = 'h2',
  class: className = '',
}: Props = Astro.props;

const isCenter = align === 'center';
const isLight = tone === 'light';
---

<div
  class:list={[
    'max-w-3xl',
    isCenter ? 'mx-auto text-center' : 'text-left',
    className,
  ]}
  data-reveal
>
  {
    eyebrow && (
      <p
        class:list={[
          'mb-3 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.22em]',
          isCenter && 'justify-center',
          isLight ? 'text-orange-400' : 'text-orange-600',
        ]}
      >
        <span class="h-px w-8 bg-current" aria-hidden="true" />
        {eyebrow}
        {isCenter && <span class="h-px w-8 bg-current" aria-hidden="true" />}
      </p>
    )
  }

  <Tag
    class:list={[
      'text-3xl leading-[1.15] sm:text-4xl lg:text-[2.75rem]',
      isLight ? 'text-white' : 'text-navy-900',
    ]}
  >
    <Fragment set:html={title} />
  </Tag>

  {
    subtitle && (
      <p
        class:list={[
          'mt-5 text-base leading-relaxed sm:text-lg',
          isLight ? 'text-white/70' : 'text-navy-900/65',
        ]}
      >
        {subtitle}
      </p>
    )
  }
</div>
