---
/**
 * Icones em SVG inline.
 *
 * Inline em vez de biblioteca: sao doze icones, todos conhecidos em build time.
 * Uma dependencia de icones traria centenas de KB e uma requisicao a mais para
 * resolver um problema que trinta linhas de path resolvem.
 */
interface Props {
  name:
    | 'water'
    | 'bolt'
    | 'document'
    | 'building'
    | 'hammer'
    | 'shield'
    | 'clipboard'
    | 'blueprint'
    | 'calendar'
    | 'ruler'
    | 'check'
    | 'arrow-right'
    | 'arrow-left'
    | 'chevron-down'
    | 'phone'
    | 'mail'
    | 'pin'
    | 'clock'
    | 'whatsapp'
    | 'instagram'
    | 'facebook'
    | 'linkedin'
    | 'quote'
    | 'menu'
    | 'close';
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;

/** Icones de traco, herdam currentColor. */
const stroke: Record<string, string> = {
  water: '<path d="M12 2.7c3.6 4.2 6 7.4 6 10.3a6 6 0 1 1-12 0c0-2.9 2.4-6.1 6-10.3Z"/>',
  bolt: '<path d="M13 2 4.5 13.2h6L11 22l8.5-11.2h-6L13 2Z"/>',
  document:
    '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h6"/>',
  building:
    '<path d="M3 21h18"/><path d="M5 21V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v16"/><path d="M15 21V11h2a2 2 0 0 1 2 2v8"/><path d="M9 7h2M9 11h2M9 15h2"/>',
  hammer:
    '<path d="m14.5 5.5 4 4"/><path d="M12 7 8.5 3.5a2.1 2.1 0 0 0-3 3L9 10"/><path d="m9 10 8 8a2.1 2.1 0 0 0 3-3l-8-8"/><path d="M4 20.5 9.5 15"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/>',
  clipboard:
    '<path d="M9 3h6v3H9z"/><path d="M15 4.5h2A2 2 0 0 1 19 6.5v13a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-13a2 2 0 0 1 2-2h2"/><path d="M9 12h6M9 16h4"/>',
  blueprint:
    '<path d="M3 5h18v14H3z"/><path d="M3 9h18M8 9v10M13 9v5h8"/>',
  calendar:
    '<path d="M4 5h16v16H4z"/><path d="M4 10h16M8 3v4M16 3v4"/>',
  ruler:
    '<rect x="1.7" y="8.2" width="20.6" height="7.6" rx="1.4" transform="rotate(-20 12 12)"/><path d="M6.6 9.6v2.2M10 8.3v3.2M13.4 7.1v2.2M16.8 5.8v3.2"/>',
  check: '<path d="m4 12 5.5 5.5L20 7"/>',
  'arrow-right': '<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>',
  'arrow-left': '<path d="M20 12H5"/><path d="m11 6-6 6 6 6"/>',
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  phone:
    '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/>',
  mail: '<path d="M3 5h18v14H3z"/><path d="m3 6 9 7 9-7"/>',
  pin: '<path d="M12 22s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z"/><circle cx="12" cy="11" r="2.6"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5.5l3.5 2"/>',
  quote:
    '<path d="M9.5 5C6.5 6.4 5 9 5 12.4V19h6.4v-6.6H8.2c0-2.4.8-3.9 2.6-4.6L9.5 5Zm9 0C15.5 6.4 14 9 14 12.4V19h6.4v-6.6h-3.2c0-2.4.8-3.9 2.6-4.6L18.5 5Z"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="m6 6 12 12M18 6 6 18"/>',
};

/** Icones de preenchimento (marcas de terceiros). */
const filled: Record<string, string> = {
  whatsapp:
    '<path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.8 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.8-.6-3.1-1.3-5.1-4.4-5.3-4.6-.1-.2-1.2-1.6-1.2-3s.7-2.1 1-2.4c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .7.5l.9 2.2c.1.2.1.4 0 .5l-.4.6-.3.3c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.7-.1l.9-1c.2-.2.4-.2.6-.1l2.1 1c.3.1.5.2.5.3.1.2.1.7-.1 1.3Z"/>',
  instagram:
    '<path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4 1 .5.4.8.8 1 1.4.2.4.3 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-1 1.4-.4.5-.8.8-1.4 1-.4.2-1 .3-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-1-.5-.4-.8-.8-1-1.4-.2-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.2-1.8.4-2.2.2-.6.5-1 1-1.4.4-.5.8-.8 1.4-1 .4-.2 1-.3 2.2-.4 1.3-.1 1.7-.1 4.9-.1Zm0 3.3a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13Zm0 10.7a4.2 4.2 0 1 1 0-8.4 4.2 4.2 0 0 1 0 8.4Zm6.7-11a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z"/>',
  facebook:
    '<path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12Z"/>',
  linkedin:
    '<path d="M4.98 3.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.76-2.05C21.4 8.65 22 11 22 14.2V21h-4v-6c0-1.43-.03-3.27-2-3.27-2 0-2.3 1.56-2.3 3.17V21h-4V9Z"/>',
};

const isFilled = name in filled;
const body = isFilled ? filled[name] : stroke[name];
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? 'none' : 'currentColor'}
  stroke-width={isFilled ? undefined : 1.7}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={body}
/>
