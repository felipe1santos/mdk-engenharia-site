---
/**
 * Navbar fixa.
 *
 * Comeca transparente sobre o hero e ganha fundo azul-marinho solido ao rolar —
 * a transicao e controlada pela classe `is-scrolled`, aplicada em reveal.ts.
 * O logo e um link para a home, como pedido.
 *
 * Itens com `children` viram dropdown no desktop e acordeao no drawer mobile.
 * O dropdown abre no hover E no foco/clique: so hover exclui quem navega por
 * teclado, e so clique irrita quem usa mouse. O `<button>` com aria-expanded
 * existe para o leitor de tela anunciar o estado; o link do pai continua
 * acessivel porque cada dropdown repete o destino como primeiro item.
 *
 * O menu mobile e um drawer em tela cheia. Enquanto aberto, o scroll do body e
 * travado e o foco fica confinado ao drawer; Esc fecha.
 */
import { Image } from 'astro:assets';
import { mainNav } from '../../data/navigation';
import { site, whatsappUrl } from '../../data/site';
import logoLight from '../../assets/logo/mdk-logo-light.png';
import Icon from '../ui/Icon.astro';

/**
 * Marca o item ativo comparando a primeira parte do caminho.
 *
 * Link de ancora da home (`/#depoimentos`) nunca fica ativo: sem esta excecao
 * ele perde a ancora na comparacao, vira "/" e acende junto com o Home.
 */
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const [base, anchor] = href.split('#');
  const clean = base.replace(/\/$/, '') || '/';
  if (clean === '/') return anchor ? false : path === '/';
  return path === clean || path.startsWith(`${clean}/`);
};
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300 ease-out"
  data-header
>
  <div
    class="absolute inset-0 -z-10 bg-navy-800/95 opacity-0 shadow-lg shadow-navy-900/20 backdrop-blur-md transition-opacity duration-300 ease-out"
    data-header-bg
    aria-hidden="true"
  >
  </div>

  <nav
    class="mx-auto flex w-full max-w-7xl items-center justify-between gap-4 px-5 py-4 transition-[padding] duration-300 sm:px-8"
    aria-label="Navegação principal"
    data-header-inner
  >
    <a
      href="/"
      class="shrink-0 cursor-pointer transition-transform duration-300 hover:scale-[1.03]"
      aria-label={`${site.name} — ir para a página inicial`}
    >
      <Image
        src={logoLight}
        alt={`Logo da ${site.legalName}`}
        widths={[220, 413]}
        sizes="(min-width: 1024px) 190px, 150px"
        class="h-9 w-auto sm:h-11"
        loading="eager"
        data-logo
      />
    </a>

    <ul class="hidden items-center gap-0.5 lg:flex">
      {
        mainNav.map((item) => (
          <li class="group relative" data-nav-item>
            {item.children ? (
              <>
                <button
                  type="button"
                  class:list={[
                    'flex cursor-pointer items-center gap-1.5 rounded-full px-3.5 py-2 text-sm font-semibold transition-colors duration-200 hover:text-white',
                    isActive(item.href) ? 'text-white' : 'text-white/85',
                  ]}
                  aria-expanded="false"
                  aria-haspopup="true"
                  data-submenu-toggle
                >
                  {item.label}
                  <Icon
                    name="chevron-down"
                    class="h-3.5 w-3.5 transition-transform duration-200 group-hover:rotate-180"
                  />
                  {isActive(item.href) && (
                    <span
                      class="absolute inset-x-3.5 bottom-1 h-0.5 bg-orange-500"
                      aria-hidden="true"
                    />
                  )}
                </button>

                <div
                  class="invisible absolute left-0 top-full z-10 min-w-56 translate-y-1 pt-2 opacity-0 transition-[opacity,translate,visibility] duration-200 ease-out group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100"
                  data-submenu
                >
                  <ul class="overflow-hidden rounded-xl border border-white/10 bg-navy-800 py-2 shadow-2xl shadow-navy-900/40">
                    <li>
                      <a
                        href={item.href}
                        class="block cursor-pointer px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-white/10"
                      >
                        {item.label}
                      </a>
                    </li>
                    <li aria-hidden="true">
                      <span class="my-1 block h-px bg-white/10" />
                    </li>
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class="block cursor-pointer px-4 py-2.5 text-sm text-white/70 transition-colors hover:bg-white/10 hover:text-orange-400"
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </>
            ) : (
              <a
                href={item.href}
                class:list={[
                  'relative block cursor-pointer rounded-full px-3.5 py-2 text-sm font-semibold transition-colors duration-200 hover:text-white',
                  isActive(item.href) ? 'text-white' : 'text-white/85',
                ]}
              >
                <span
                  class:list={[
                    'absolute inset-x-3.5 bottom-1 h-0.5 origin-left bg-orange-500 transition-[scale] duration-300 ease-out',
                    isActive(item.href) ? 'scale-x-100' : 'scale-x-0',
                  ]}
                  aria-hidden="true"
                  data-underline
                />
                {item.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-3">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden cursor-pointer items-center gap-2 rounded-full bg-orange-500 px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-orange-500/25 transition-all duration-300 hover:-translate-y-0.5 hover:bg-orange-400 hover:shadow-xl sm:inline-flex"
      >
        <Icon name="whatsapp" class="h-4 w-4" />
        Solicitar Orçamento
      </a>

      <button
        type="button"
        class="inline-flex cursor-pointer items-center justify-center rounded-lg p-2 text-white transition-colors hover:bg-white/10 lg:hidden"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        data-menu-open
      >
        <Icon name="menu" class="h-7 w-7" />
      </button>
    </div>
  </nav>
</header>

<!-- Drawer mobile -->
<div
  id="mobile-drawer"
  class="invisible fixed inset-0 z-[60] opacity-0 transition-[opacity,visibility] duration-300 lg:hidden"
  data-drawer
>
  <div class="absolute inset-0 bg-navy-900/70 backdrop-blur-sm" data-drawer-backdrop></div>

  <div
    class="absolute inset-y-0 right-0 flex w-full max-w-sm translate-x-full flex-col bg-navy-800 shadow-2xl transition-[translate] duration-300 ease-out"
    role="dialog"
    aria-modal="true"
    aria-label="Menu de navegação"
    data-drawer-panel
  >
    <div class="flex items-center justify-between border-b border-white/10 px-5 py-4">
      <Image
        src={logoLight}
        alt={`Logo da ${site.legalName}`}
        widths={[180]}
        class="h-9 w-auto"
        loading="eager"
      />
      <button
        type="button"
        class="cursor-pointer rounded-lg p-2 text-white transition-colors hover:bg-white/10"
        aria-label="Fechar menu"
        data-menu-close
      >
        <Icon name="close" class="h-6 w-6" />
      </button>
    </div>

    <ul class="flex-1 overflow-y-auto px-3 py-4">
      {
        mainNav.map((item) => (
          <li>
            {item.children ? (
              <div data-accordion>
                <div class="flex items-center">
                  <a
                    href={item.href}
                    class="flex-1 cursor-pointer rounded-xl px-4 py-3.5 text-base font-semibold text-white/90 transition-colors hover:bg-white/10 hover:text-white"
                    data-drawer-link
                  >
                    {item.label}
                  </a>
                  <button
                    type="button"
                    class="cursor-pointer rounded-xl p-3 text-white/70 transition-colors hover:bg-white/10 hover:text-white"
                    aria-expanded="false"
                    aria-label={`Abrir submenu de ${item.label}`}
                    data-accordion-toggle
                  >
                    <Icon
                      name="chevron-down"
                      class="h-5 w-5 transition-transform duration-300"
                      data-accordion-icon
                    />
                  </button>
                </div>

                <ul class="hidden pb-2 pl-4" data-accordion-panel>
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="flex cursor-pointer items-center gap-2.5 rounded-lg px-4 py-2.5 text-sm text-white/65 transition-colors hover:bg-white/10 hover:text-orange-400"
                        data-drawer-link
                      >
                        <span class="h-px w-3 bg-orange-500/70" aria-hidden="true" />
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <a
                href={item.href}
                class="flex cursor-pointer items-center justify-between rounded-xl px-4 py-3.5 text-base font-semibold text-white/90 transition-colors hover:bg-white/10 hover:text-white"
                data-drawer-link
              >
                {item.label}
                <Icon name="arrow-right" class="h-4 w-4 text-orange-500" />
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <div class="border-t border-white/10 p-5">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-orange-500 px-6 py-3.5 text-base font-bold text-white transition-colors hover:bg-orange-400"
      >
        <Icon name="whatsapp" class="h-5 w-5" />
        Solicitar Orçamento
      </a>
      <p class="mt-4 text-center text-sm text-white/55">{site.contact.hours}</p>
    </div>
  </div>
</div>

<script>
  /**
   * Acordeao do drawer mobile e estado do dropdown do desktop.
   *
   * O dropdown em si abre por CSS (hover e focus-within), que funciona sem
   * JavaScript. Este script apenas mantem `aria-expanded` coerente com o que
   * esta visivel — sem isso o leitor de tela anuncia "recolhido" com o menu
   * aberto na tela.
   */
  const accordions = document.querySelectorAll<HTMLElement>('[data-accordion]');

  for (const accordion of accordions) {
    const toggle = accordion.querySelector<HTMLButtonElement>('[data-accordion-toggle]');
    const panel = accordion.querySelector<HTMLElement>('[data-accordion-panel]');
    const icon = accordion.querySelector<HTMLElement>('[data-accordion-icon]');
    if (!toggle || !panel) continue;

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      panel.classList.toggle('hidden', open);
      icon?.classList.toggle('rotate-180', !open);
    });
  }

  const submenuItems = document.querySelectorAll<HTMLElement>('[data-nav-item]');

  for (const item of submenuItems) {
    const toggle = item.querySelector<HTMLButtonElement>('[data-submenu-toggle]');
    if (!toggle) continue;

    const setState = (open: boolean) => toggle.setAttribute('aria-expanded', String(open));

    item.addEventListener('pointerenter', () => setState(true));
    item.addEventListener('pointerleave', () => setState(false));
    item.addEventListener('focusin', () => setState(true));
    item.addEventListener('focusout', (event) => {
      if (!item.contains(event.relatedTarget as Node)) setState(false);
    });

    // Esc devolve o foco ao gatilho e fecha, que e o comportamento esperado de
    // menu com submenu.
    item.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setState(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  [data-drawer].is-open {
    visibility: visible;
    opacity: 1;
  }

  /* `translate`, nao `transform`: no Tailwind 4 a utilitaria `translate-x-full`
     escreve na propriedade `translate`. Sobrescrever `transform` nao move nada e
     o painel fica parado fora da tela. */
  [data-drawer].is-open [data-drawer-panel] {
    translate: none;
  }
</style>
