---
/**
 * Endereco e mapa.
 *
 * O mapa e o Google Maps Embed em <iframe>, sem chave de API. A alternativa
 * (Maps JavaScript API) exigiria chave, conta de faturamento habilitada e
 * deixaria a chave exposta no cliente — tudo isso para o mesmo resultado visual.
 *
 * O iframe e lazy: e pesado e fica abaixo da dobra, entao carregar de imediato
 * so atrapalharia o LCP.
 */
import { site, fullAddress, mapEmbedUrl, mapDirectionsUrl, whatsappUrl } from '../../data/site';
import Section from '../ui/Section.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import Icon from '../ui/Icon.astro';

const contactItems = [
  { icon: 'pin', label: 'Endereço', value: fullAddress, href: mapDirectionsUrl, external: true },
  {
    icon: 'phone',
    label: 'Telefone',
    value: site.contact.phoneDisplay,
    href: `tel:${site.contact.phoneE164}`,
  },
  { icon: 'whatsapp', label: 'WhatsApp', value: 'Atendimento rápido', href: whatsappUrl, external: true },
  { icon: 'mail', label: 'E-mail', value: site.contact.email, href: `mailto:${site.contact.email}` },
  { icon: 'clock', label: 'Horário', value: site.contact.hours },
] as const;
---

<Section tone="offwhite" width="wide">
  <SectionTitle
    eyebrow="Onde estamos"
    title="Venha nos <span class='text-orange-600'>visitar</span>"
    subtitle="Atendimento técnico presencial mediante agendamento."
  />

  <div class="mt-14 overflow-hidden rounded-2xl bg-white shadow-card lg:grid lg:grid-cols-5">
    <!-- Dados de contato -->
    <div class="bg-navy-800 p-8 sm:p-10 lg:col-span-2" data-reveal>
      <h3 class="text-xl text-white">{site.legalName}</h3>
      <span class="mt-4 block h-0.5 w-10 bg-orange-500" aria-hidden="true"></span>

      <ul class="mt-8 space-y-6">
        {
          contactItems.map((item) => {
            const content = (
              <>
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white/8 text-orange-500 transition-colors duration-300 group-hover:bg-orange-500 group-hover:text-white">
                  <Icon name={item.icon} class="h-5 w-5" />
                </span>
                <span>
                  <span class="block text-[0.6875rem] font-bold uppercase tracking-[0.14em] text-white/45">
                    {item.label}
                  </span>
                  <span class="mt-1 block text-sm leading-relaxed text-white/85">{item.value}</span>
                </span>
              </>
            );

            return (
              <li>
                {'href' in item && item.href ? (
                  <a
                    href={item.href}
                    target={'external' in item && item.external ? '_blank' : undefined}
                    rel={'external' in item && item.external ? 'noopener noreferrer' : undefined}
                    class="group flex cursor-pointer gap-4 transition-opacity hover:opacity-90"
                  >
                    {content}
                  </a>
                ) : (
                  <div class="group flex gap-4">{content}</div>
                )}
              </li>
            );
          })
        }
      </ul>

      <a
        href={mapDirectionsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-9 inline-flex cursor-pointer items-center gap-2 rounded-full bg-orange-500 px-6 py-3 text-sm font-bold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-orange-400"
      >
        <Icon name="pin" class="h-4 w-4" />
        Como chegar
      </a>
    </div>

    <!-- Mapa -->
    <div class="relative min-h-[22rem] lg:col-span-3 lg:min-h-[30rem]" data-reveal style="--reveal-delay:140ms">
      <iframe
        src={mapEmbedUrl}
        title={`Mapa com a localização da ${site.legalName} — ${fullAddress}`}
        class="absolute inset-0 h-full w-full border-0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
    </div>
  </div>
</Section>
