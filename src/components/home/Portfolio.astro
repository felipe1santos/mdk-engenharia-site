---
/**
 * Grid de servicos realizados.
 *
 * As fotos sao de banco e estao marcadas como placeholder — foto generica em
 * portfolio nao gera confianca local e, se o cliente reconhecer o banco, gera o
 * efeito contrario. Substituir por fotos reais de obra da MDK e remover a flag
 * em src/data/portfolio.ts.
 */
import { Image } from 'astro:assets';
import { portfolio } from '../../data/portfolio';
import { getImage } from '../../lib/images';
import Section from '../ui/Section.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import Icon from '../ui/Icon.astro';

const anyPlaceholder = portfolio.some((p) => p.placeholder);
---

<Section id="projetos" tone="offwhite" width="wide">
  <SectionTitle
    eyebrow="Portfólio"
    title="Serviços <span class='text-orange-600'>realizados</span>"
    subtitle="Projetos e obras acompanhados pela equipe da MDK em São Paulo e Grande SP."
  />

  <div
    class:list={['mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3', anyPlaceholder && 'ph']}
  >
    {
      portfolio.map((item, i) => {
        const img = getImage(item.image);
        return (
          <article
            class="group relative cursor-pointer overflow-hidden rounded-2xl bg-navy-900 shadow-card transition-all duration-400 hover:-translate-y-1.5 hover:shadow-card-hover"
            data-reveal
            style={`--reveal-delay:${(i % 3) * 120}ms`}
          >
            <Image
              src={img.src}
              alt={`${item.title} — ${item.location}`}
              widths={[400, 700, 900]}
              sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 92vw"
              class="aspect-4/3 w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />

            {/* Degrade concentrado no terco inferior: da fundo para o texto sem
                lavar a foto. Antes o cartao usava opacidade na propria imagem
                somada a um degrade de altura inteira, o que deixava tudo
                acinzentado. */}
            <div
              class="absolute inset-0 bg-[linear-gradient(to_top,rgba(6,18,37,0.97)_0%,rgba(6,18,37,0.9)_20%,rgba(6,18,37,0.45)_44%,rgba(6,18,37,0.08)_66%,transparent_100%)] transition-opacity duration-400"
              aria-hidden="true"
            />

            {/* A seta fica posicionada de forma absoluta no canto superior.
                Dentro do fluxo do bloco de texto ela reservava altura mesmo
                invisivel, empurrando titulo e local para cima do rodape do
                cartao. */}
            <span
              class="absolute right-5 top-5 flex h-9 w-9 -translate-y-1 items-center justify-center rounded-full bg-white/15 text-white opacity-0 backdrop-blur-sm transition-all duration-400 group-hover:translate-y-0 group-hover:opacity-100"
              aria-hidden="true"
            >
              <Icon name="arrow-right" class="h-4 w-4" />
            </span>

            <div class="absolute inset-x-0 bottom-0 px-6 pb-5 pt-6">
              <span class="inline-flex rounded-full bg-orange-500 px-3 py-1 text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-white">
                {item.category}
              </span>

              <h3 class="mt-2.5 text-lg leading-snug text-white">{item.title}</h3>

              <p class="mt-1 flex items-center gap-1.5 text-sm text-white/70">
                <Icon name="pin" class="h-3.5 w-3.5 text-orange-500" />
                {item.location}
              </p>
            </div>
          </article>
        );
      })
    }
  </div>
</Section>
