---
/**
 * Os tres orgaos onde a MDK protocola: Prefeitura, Corpo de Bombeiros e CETESB.
 *
 * Reproduz a divisao que o cliente ja usa no panfleto impresso e no site
 * anterior — e a forma como o proprio mercado organiza o assunto. Cada card leva
 * para a pagina do orgao.
 *
 * A imagem ocupa o card inteiro com o texto sobreposto, e nao um slot separado:
 * sao tres cartoes so, e o formato cheio da peso a secao sem precisar de mais
 * altura de pagina.
 */
import { Image } from 'astro:assets';
import { agencies } from '../../data/agencies';
import { getImage } from '../../lib/images';
import Section from '../ui/Section.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  id?: string;
  tone?: 'white' | 'offwhite';
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  /**
   * `photo` e o cartao cheio, com fotografia de contexto e texto sobreposto.
   *
   * `logo` troca a fotografia pelo brasao/logotipo de cada orgao (`agency.cover`)
   * e vira cartao claro, com o texto abaixo da imagem. E obrigatorio que mude de
   * layout junto: logo pede `object-contain` sobre fundo claro, e texto branco
   * sobre um gradiente escuro por cima de um logotipo fica ilegivel dos dois
   * lados. Usado hoje so em /servicos, a pedido do cliente. A ressalva sobre
   * exibir insignia de orgao publico esta no topo de src/data/agencies.ts.
   */
  variant?: 'photo' | 'logo';
}

const {
  id = 'orgaos',
  tone = 'offwhite',
  eyebrow = 'Onde protocolamos',
  title = "Aprovação e <span class='text-orange-600'>regularização</span>",
  subtitle = 'Cada obra passa por balcões diferentes, com exigências próprias. Cuidamos dos três, do protocolo à emissão do documento.',
  variant = 'photo',
} = Astro.props;
---

<Section id={id} tone={tone} width="wide">
  <SectionTitle eyebrow={eyebrow} title={title} subtitle={subtitle} />

  <ul class="mt-14 grid gap-6 md:grid-cols-3">
    {
      agencies.map((agency, i) => {
        const img = getImage(variant === 'logo' ? agency.cover : agency.image);

        if (variant === 'logo') {
          return (
            <li data-reveal style={`--reveal-delay:${i * 110}ms`}>
              <a
                href={`/servicos/regularizacao/${agency.id}`}
                class="group flex h-full cursor-pointer flex-col overflow-hidden rounded-2xl border border-navy-900/10 bg-white shadow-card transition-all duration-400 hover:-translate-y-1.5 hover:border-orange-500/40 hover:shadow-card-hover"
              >
                <div class="relative flex aspect-[16/9] items-center justify-center border-b border-navy-900/10 bg-navy-900/[0.04] p-8">
                  <Image
                    src={img.src}
                    alt={img.alt}
                    widths={[300, 600]}
                    sizes="(min-width: 768px) 300px, 80vw"
                    class="h-full w-full object-contain transition-transform duration-500 ease-out group-hover:scale-105"
                    loading="lazy"
                  />
                  <span class="absolute bottom-4 left-4 flex h-11 w-11 items-center justify-center rounded-xl bg-orange-500 text-white shadow-lg transition-transform duration-300 group-hover:scale-110">
                    <Icon name={agency.icon} class="h-5 w-5" />
                  </span>
                </div>

                <div class="flex flex-1 flex-col p-7">
                  <h3 class="text-xl leading-snug text-navy-900">{agency.name}</h3>
                  <p class="mt-1 text-sm font-semibold text-orange-600">{agency.tagline}</p>

                  <ul class="mt-5 space-y-2.5 border-t border-navy-900/8 pt-5">
                    {agency.bullets.slice(0, 4).map((b) => (
                      <li class="flex items-start gap-2.5 text-[0.8125rem] leading-snug text-navy-900/75">
                        <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-orange-500" />
                        {b}
                      </li>
                    ))}
                  </ul>

                  <span class="mt-auto inline-flex items-center gap-2 pt-6 text-sm font-bold text-navy-800 transition-colors group-hover:text-orange-600">
                    Ver detalhes
                    <Icon
                      name="arrow-right"
                      class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                    />
                  </span>
                </div>
              </a>
            </li>
          );
        }

        return (
          <li data-reveal style={`--reveal-delay:${i * 110}ms`}>
            <a
              href={`/servicos/regularizacao/${agency.id}`}
              class="group relative flex h-full min-h-80 cursor-pointer flex-col justify-end overflow-hidden rounded-2xl bg-navy-900 shadow-card transition-all duration-400 hover:-translate-y-1.5 hover:shadow-card-hover"
            >
              <Image
                src={img.src}
                alt={img.alt}
                widths={[400, 700, 1000]}
                sizes="(min-width: 768px) 33vw, 92vw"
                class="absolute inset-0 h-full w-full object-cover opacity-70 transition-all duration-700 ease-out group-hover:scale-105 group-hover:opacity-50"
                loading="lazy"
              />

              <div
                class="absolute inset-0 bg-gradient-to-t from-navy-900 via-navy-900/70 to-navy-900/20"
                aria-hidden="true"
              />

              <div class="relative p-7">
                <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-orange-500 text-white shadow-lg transition-transform duration-300 group-hover:scale-110">
                  <Icon name={agency.icon} class="h-6 w-6" />
                </span>

                <h3 class="mt-5 font-display text-xl leading-snug text-white">{agency.name}</h3>
                <p class="mt-1 text-sm font-semibold text-orange-400">{agency.tagline}</p>
                <p class="mt-3 text-sm leading-relaxed text-white/70">{agency.summary}</p>

                <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-white">
                  Ver detalhes
                  <Icon
                    name="arrow-right"
                    class="h-4 w-4 text-orange-500 transition-transform duration-300 group-hover:translate-x-1"
                  />
                </span>
              </div>
            </a>
          </li>
        );
      })
    }
  </ul>
</Section>
