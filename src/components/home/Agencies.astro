---
/**
 * Os tres orgaos onde a MDK protocola: Prefeitura, Corpo de Bombeiros e CETESB.
 *
 * Reproduz a divisao que o cliente ja usa no panfleto impresso e no site
 * anterior — e a forma como o proprio mercado organiza o assunto. Cada card leva
 * para a pagina do orgao.
 *
 * A imagem ocupa o card inteiro com o texto sobreposto, e nao um slot separado:
 * sao tres cartoes so, e o formato cheio da peso a secao sem precisar de mais
 * altura de pagina.
 */
import { Image } from 'astro:assets';
import { agencies } from '../../data/agencies';
import { getImage } from '../../lib/images';
import Section from '../ui/Section.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  id?: string;
  tone?: 'white' | 'offwhite';
  eyebrow?: string;
  title?: string;
  subtitle?: string;
}

const {
  id = 'orgaos',
  tone = 'offwhite',
  eyebrow = 'Onde protocolamos',
  title = "Aprovação e <span class='text-orange-600'>regularização</span>",
  subtitle = 'Cada obra passa por balcões diferentes, com exigências próprias. Cuidamos dos três, do protocolo à emissão do documento.',
} = Astro.props;
---

<Section id={id} tone={tone} width="wide">
  <SectionTitle eyebrow={eyebrow} title={title} subtitle={subtitle} />

  <ul class="mt-14 grid gap-6 md:grid-cols-3">
    {
      agencies.map((agency, i) => {
        const img = getImage(agency.image);
        return (
          <li data-reveal style={`--reveal-delay:${i * 110}ms`}>
            <a
              href={`/servicos/regularizacao/${agency.id}`}
              class="group relative flex h-full min-h-80 cursor-pointer flex-col justify-end overflow-hidden rounded-2xl bg-navy-900 shadow-card transition-all duration-400 hover:-translate-y-1.5 hover:shadow-card-hover"
            >
              <Image
                src={img.src}
                alt={img.alt}
                widths={[400, 700, 1000]}
                sizes="(min-width: 768px) 33vw, 92vw"
                class="absolute inset-0 h-full w-full object-cover opacity-70 transition-all duration-700 ease-out group-hover:scale-105 group-hover:opacity-50"
                loading="lazy"
              />

              <div
                class="absolute inset-0 bg-gradient-to-t from-navy-900 via-navy-900/70 to-navy-900/20"
                aria-hidden="true"
              />

              <div class="relative p-7">
                <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-orange-500 text-white shadow-lg transition-transform duration-300 group-hover:scale-110">
                  <Icon name={agency.icon} class="h-6 w-6" />
                </span>

                <h3 class="mt-5 font-display text-xl leading-snug text-white">{agency.name}</h3>
                <p class="mt-1 text-sm font-semibold text-orange-400">{agency.tagline}</p>
                <p class="mt-3 text-sm leading-relaxed text-white/70">{agency.summary}</p>

                <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-white">
                  Ver detalhes
                  <Icon
                    name="arrow-right"
                    class="h-4 w-4 text-orange-500 transition-transform duration-300 group-hover:translate-x-1"
                  />
                </span>
              </div>
            </a>
          </li>
        );
      })
    }
  </ul>
</Section>
