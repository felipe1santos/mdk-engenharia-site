---
/**
 * Faixa laranja diagonal com contadores animados.
 *
 * Espelha a referencia enviada pelo cliente: corte enviesado no topo, textura de
 * pontos e numeros grandes com icone.
 *
 * Os valores sao PLACEHOLDER. Enquanto `placeholder` estiver ligado em
 * src/data/stats.ts, o bloco recebe a marcacao .ph — numeros nao comprovaveis em
 * site institucional configuram publicidade enganosa, entao ninguem deve
 * publicar isso por engano.
 */
import { stats } from '../../data/stats';
import Icon from '../ui/Icon.astro';

const anyPlaceholder = stats.some((s) => s.placeholder);
---

<section
  class="clip-slant relative -mb-px overflow-hidden bg-orange-500 pb-16 pt-28 sm:pb-20 sm:pt-36"
  aria-label="MDK Engenharia em números"
>
  <div class="bg-dots absolute inset-0 text-white/20" aria-hidden="true"></div>
  <div
    class="absolute -left-16 top-1/4 h-64 w-64 rounded-full bg-white/8 blur-2xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-y-0 right-[-10%] w-1/3 -skew-x-12 bg-white/6"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto w-full max-w-6xl px-5 sm:px-8">
    <div class="mb-12 max-w-xl" data-reveal>
      <p class="text-xs font-bold uppercase tracking-[0.22em] text-white/75">Nossos números</p>
      <h2 class="mt-3 text-3xl leading-tight text-white sm:text-4xl">
        Planejamento e execução que viram <span class="text-navy-900">resultados</span>
      </h2>
    </div>

    <dl class:list={['grid grid-cols-2 gap-y-10 sm:gap-8 lg:grid-cols-4', anyPlaceholder && 'ph']}>
      {
        stats.map((stat, i) => (
          <div class="flex items-start gap-4" data-reveal style={`--reveal-delay:${i * 110}ms`}>
            <span
              class="hidden h-14 w-14 shrink-0 items-center justify-center rounded-2xl border-2 border-white/35 text-white sm:flex"
              aria-hidden="true"
            >
              <Icon name={stat.icon} class="h-7 w-7" />
            </span>

            <div>
              <dt class="sr-only">{stat.label}</dt>
              <dd>
                <span class="block whitespace-nowrap font-display text-[2rem] font-extrabold leading-none tracking-tight text-white sm:text-4xl lg:text-5xl">
                  {stat.prefix}
                  <span data-counter={stat.value}>0</span>
                  {stat.suffix}
                </span>
                <span class="mt-2 block text-sm font-medium text-white/80">{stat.label}</span>
              </dd>
            </div>
          </div>
        ))
      }
    </dl>
  </div>
</section>
