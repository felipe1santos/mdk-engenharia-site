---
/**
 * Frentes complementares ao projeto: documentacao, execucao e consultoria de
 * obra. Ficam em grid compacto porque o nucleo tecnico da empresa e o projeto,
 * mas precisam existir na pagina: quem busca "regularizacao" ou "consultoria de
 * obra" tambem e cliente, e o texto amplia a cobertura semantica da home.
 *
 * Os itens com `bullets` preenchidos exibem o escopo; os demais ficam so com a
 * frase-resumo, o que mantem os cards com altura parecida.
 *
 * A foto a esquerda existe por contraste: a home vinha de quatro cards com foto
 * no bloco "O que fazemos" e caia numa grade so de texto e icone. A imagem
 * vertical do canteiro devolve peso a secao e diz, sem escrever, que esta parte
 * e sobre obra — enquanto a anterior era sobre papel.
 */
import { Image } from 'astro:assets';
import { secondaryServices, segments } from '../../data/services';
import { getImage } from '../../lib/images';
import Section from '../ui/Section.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import Icon from '../ui/Icon.astro';

const apoio = getImage('apoio-execucao');
---

<Section tone="white" space="md" width="wide">
  <SectionTitle
    eyebrow="Também atendemos"
    title="Da documentação à execução"
    subtitle={`Obras e consultoria nos segmentos ${segments.join(', ').toLowerCase()} — com a mesma responsabilidade técnica do projeto.`}
    as="h2"
  />

  <div class="mt-12 grid gap-8 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-10">
    {/* A foto some abaixo de lg: em coluna unica ela viraria um bloco alto
        entre o titulo e os cards, empurrando o conteudo para fora da tela. */}
    <figure
      class="relative hidden overflow-hidden rounded-2xl bg-navy-900 lg:block"
      data-reveal
    >
      <Image
        src={apoio.src}
        alt={apoio.alt}
        widths={[400, 700]}
        sizes="320px"
        class="h-full w-full object-cover"
        loading="lazy"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-navy-900 via-navy-900/25 to-transparent"
        aria-hidden="true"
      />
      <figcaption class="absolute inset-x-0 bottom-0 p-7">
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-orange-400">No canteiro</p>
        <p class="mt-3 text-lg leading-snug text-white">
          Quem projeta e executa responde pelas duas pontas.
        </p>
      </figcaption>
    </figure>

    <div class="grid gap-5 sm:grid-cols-2">
      {
        secondaryServices.map((service, i) => (
          <a
            href={`/servicos/${service.id}`}
          class="group relative block cursor-pointer overflow-hidden rounded-xl border border-navy-900/10 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-orange-500/40 hover:shadow-card"
          data-reveal
          style={`--reveal-delay:${i * 90}ms`}
        >
          <span
            class="absolute inset-x-0 top-0 h-0.5 origin-left scale-x-0 bg-orange-500 transition-transform duration-400 ease-out group-hover:scale-x-100"
            aria-hidden="true"
          />
          <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-navy-800/5 text-navy-800 transition-colors duration-300 group-hover:bg-orange-500 group-hover:text-white">
            <Icon name={service.icon} class="h-5 w-5" />
          </span>
          <h3 class="mt-4 text-base leading-snug text-navy-900">{service.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-navy-900/60">{service.summary}</p>

          {service.bullets.length > 0 && (
            <ul class="mt-4 space-y-2 border-t border-navy-900/8 pt-4">
              {service.bullets.map((b) => (
                <li class="flex items-start gap-2 text-[0.8125rem] leading-snug text-navy-900/70">
                  <Icon name="check" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-orange-500" />
                  {b}
                </li>
              ))}
            </ul>
          )}
          </a>
        ))
      }
    </div>
  </div>
</Section>
