---
/**
 * Secao institucional.
 *
 * Traz o significado do simbolo — a armacao de coluna representa estabilidade,
 * solidez e resistencia. Contar isso e o que separa um "sobre nos" generico de
 * uma pagina que constroi autoridade.
 *
 * NOTA SOBRE O "K": a orientacao do simbolo no site foi definida pelo cliente —
 * chevron com a boca virada para o "D" e coluna de armacao a direita, servindo
 * de haste. O espelhamento esta em scripts/extract-logo.mjs. Este texto fala so
 * da coluna, de proposito: o manual atribui significado ao "K INVERTIDO", e
 * repetir esse texto ao lado de um simbolo reorientado seria incoerente.
 */
import { Image } from 'astro:assets';
import { getImage } from '../../lib/images';
import { institutional } from '../../data/institutional';
import Section from '../ui/Section.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import Icon from '../ui/Icon.astro';
import logoSymbol from '../../assets/logo/mdk-symbol-light.png';

interface Props {
  /** A home ancora em #sobre; a pagina /sobre ancora em #historia. */
  id?: string;
}

const { id = 'sobre' } = Astro.props;

const about = getImage('about');
const { intro, values, missionVisionValues } = institutional;
---

<Section id={id} tone="white" width="wide">
  <div class="grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
    <!-- Imagem. `isolate` mantem a textura de pontos com z-index negativo dentro
         deste contexto de empilhamento, em vez de deixa-la cair atras do fundo
         da secao. -->
    <div class="relative isolate" data-reveal>
      <div class="relative overflow-hidden rounded-2xl shadow-card-hover">
        <Image
          src={about.src}
          alt={about.alt}
          widths={[500, 800, 1100]}
          sizes="(min-width: 1024px) 520px, 92vw"
          class="aspect-4/3 w-full object-cover"
          loading="lazy"
        />
      </div>

      <!-- Cartao do simbolo, sobreposto -->
      <div
        class="absolute -bottom-7 -right-4 hidden w-56 rounded-2xl bg-navy-800 p-6 shadow-xl sm:block lg:-right-8"
      >
        <Image
          src={logoSymbol}
          alt="Símbolo da MDK: coluna de armação formando a haste do K"
          widths={[120, 173]}
          class="h-14 w-auto"
          loading="lazy"
        />
        <p class="mt-4 text-xs leading-relaxed text-white/65">
          A <strong class="text-white">armação de coluna</strong> forma a haste do K — símbolo de
          resistência, estabilidade e solidez.
        </p>
      </div>

      <div
        class="bg-dots absolute -left-6 -top-6 -z-10 h-32 w-32 text-orange-500/25"
        aria-hidden="true"
      >
      </div>
    </div>

    <!-- Texto -->
    <div>
      <SectionTitle
        eyebrow="Sobre a MDK"
        title="Engenharia que sustenta <span class='text-orange-600'>grandes obras</span>"
        align="left"
      />

      <div class="mt-6 space-y-5 text-base leading-relaxed text-navy-900/70" data-reveal>
        {intro.map((p) => <p>{p}</p>)}
      </div>

      <dl class="mt-9 grid gap-x-6 gap-y-5 sm:grid-cols-2">
        {
          values.map((v, i) => (
            <div class="flex gap-3" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <Icon name="check" class="mt-1 h-5 w-5 shrink-0 text-orange-500" />
              <div>
                <dt class="font-display text-sm font-bold uppercase tracking-[0.1em] text-navy-900">
                  {v.title}
                </dt>
                <dd class="mt-1 text-sm leading-relaxed text-navy-900/60">{v.text}</dd>
              </div>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <!-- Missao, Visao e Valores. Ficam depois da dobra institucional, e nao na
       faixa logo abaixo do hero: aquela faixa e elemento de conversao e texto
       institucional ali derruba o inicio da leitura. -->
  <div id="missao-visao-valores" class="mt-20 scroll-mt-28 border-t border-navy-900/8 pt-14">
    <p
      class="text-center text-xs font-bold uppercase tracking-[0.22em] text-orange-600"
      data-reveal
    >
      Missão, Visão e Valores
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        missionVisionValues.map((item, i) => (
          <article
            class="rounded-2xl border border-navy-900/10 bg-offwhite p-7 transition-colors duration-300 hover:border-orange-500/40"
            data-reveal
            style={`--reveal-delay:${i * 110}ms`}
          >
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-navy-800 text-orange-500">
              <Icon name={item.icon} class="h-6 w-6" />
            </span>
            <h3 class="mt-5 font-display text-sm font-bold uppercase tracking-[0.12em] text-navy-900">
              {item.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-navy-900/65">{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</Section>
