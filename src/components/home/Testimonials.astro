---
/**
 * Carrossel de depoimentos, no formato da referencia enviada pelo cliente:
 * cartao branco com aspas, avatar do autor e setas laranja redondas.
 *
 * OS TEXTOS SAO FICTICIOS. Ver o aviso no topo de src/data/testimonials.ts: sao
 * conteudo de demonstracao ate existirem avaliacoes reais no Google Meu Negocio.
 * O contorno tracejado continua ali, agora com o rotulo neutro "DEPOIMENTOS DE
 * CLIENTES" — o cliente pediu para manter o tratamento visual sem a etiqueta de
 * pendencia. O aviso de verdade vive no codigo e no README, nao mais na tela.
 *
 * O carrossel usa scroll-snap nativo: a rolagem horizontal ja funciona por
 * toque, trackpad e teclado sem JavaScript; as setas apenas roubam um
 * scrollBy. Uma biblioteca de carrossel aqui seria peso morto.
 */
import { testimonials } from '../../data/testimonials';
import Section from '../ui/Section.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import Icon from '../ui/Icon.astro';
---

<Section id="depoimentos" tone="white" width="wide">
  <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
    <SectionTitle
      eyebrow="Depoimentos"
      title="O que dizem <span class='text-orange-600'>nossos clientes</span>"
      align="left"
      class="md:max-w-xl"
    />

    <div class="flex gap-3" data-reveal>
      <button
        type="button"
        class="flex h-12 w-12 cursor-pointer items-center justify-center rounded-full border-2 border-navy-900/12 text-navy-800 transition-all duration-300 hover:border-orange-500 hover:bg-orange-500 hover:text-white"
        aria-label="Depoimento anterior"
        data-slider-prev
      >
        <Icon name="arrow-left" class="h-5 w-5" />
      </button>
      <button
        type="button"
        class="flex h-12 w-12 cursor-pointer items-center justify-center rounded-full bg-orange-500 text-white shadow-lg shadow-orange-500/25 transition-all duration-300 hover:bg-orange-400"
        aria-label="Próximo depoimento"
        data-slider-next
      >
        <Icon name="arrow-right" class="h-5 w-5" />
      </button>
    </div>
  </div>

  <div
    class="ph relative mt-12"
    data-reveal
    style="--reveal-delay:120ms; --ph-label:'depoimentos de clientes'"
  >
    <ul
      class="-mx-1 flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth px-1 pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      data-slider-track
      tabindex="0"
      aria-label="Depoimentos de clientes"
    >
      {
        testimonials.map((t) => (
          <li class="w-[85%] shrink-0 snap-start sm:w-[48%] lg:w-[calc(33.333%-1rem)]">
            <figure class="flex h-full flex-col rounded-2xl border border-navy-900/8 bg-white p-8 shadow-card transition-shadow duration-300 hover:shadow-card-hover">
              <div class="flex items-start justify-between gap-4">
                <Icon name="quote" class="h-8 w-8 shrink-0 text-orange-500/25" />
                {t.service && (
                  <span class="rounded-full bg-orange-500/10 px-3 py-1 text-[0.625rem] font-bold uppercase tracking-[0.1em] text-orange-600">
                    {t.service}
                  </span>
                )}
              </div>

              <blockquote class="mt-5 flex-1 text-base leading-relaxed text-navy-900/75">
                {t.quote}
              </blockquote>

              <figcaption class="mt-7 flex items-center gap-4 border-t border-navy-900/8 pt-6">
                <span
                  class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-navy-800 font-display text-sm font-bold text-white"
                  aria-hidden="true"
                >
                  {t.initials}
                </span>
                <div>
                  <p class="font-display text-sm font-bold text-navy-900">{t.author}</p>
                  <p class="text-sm text-navy-900/65">
                    {t.role} · {t.company}
                  </p>
                </div>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
