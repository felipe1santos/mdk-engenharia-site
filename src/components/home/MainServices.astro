---
/**
 * "O que fazemos" — os quatro cards da home.
 *
 * O documento de ajustes R01 do cliente pediu explicitamente para reduzir este
 * bloco a quatro frentes: Projetos, Prefeitura, Bombeiros e CETESB, cada uma com
 * sua foto de capa e com o escopo listado dentro do card.
 *
 * As nove disciplinas de projeto sairam daqui e vivem agora em /servicos#projetos
 * — o card "Projetos" e a porta de entrada delas. O ganho e de leitura: nove
 * cards grandes na primeira rolagem faziam o visitante escanear sem ler nenhum,
 * e as tres frentes de orgao ficavam mais abaixo, competindo com o mesmo assunto.
 *
 * Os tres cards de orgao vem de `agencies` — a mesma fonte da secao Agencies
 * usada nas paginas internas. Nao ha texto duplicado entre os dois componentes,
 * so markup diferente para contextos diferentes: aqui o card carrega o escopo
 * item a item, la ele e compacto.
 *
 * AS CAPAS SAO FOTOGRAFIAS, e nao pranchas tecnicas — dai `object-cover` com
 * gradiente, e nao o `object-contain` sobre branco que o acervo de desenhos
 * exigia. As capas dos orgaos sao deliberadamente fotos de contexto, e nao os
 * brasoes oficiais: exibir a insignia do Corpo de Bombeiros ou o logo da CETESB
 * num card de servico sugere credenciamento ou vinculo que a MDK nao tem. Ver a
 * nota no topo de src/data/agencies.ts.
 */
import { Image } from 'astro:assets';
import { agencies, type Agency } from '../../data/agencies';
import { primaryServices } from '../../data/services';
import { getImage } from '../../lib/images';
import Section from '../ui/Section.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Card {
  title: string;
  tagline: string;
  summary: string;
  bullets: string[];
  image: string;
  icon: 'blueprint' | Agency['icon'];
  href: string;
}

/* O card de projetos lista as disciplinas a partir de `primaryServices`, e nao
   de uma lista escrita a mao: quando uma disciplina entra ou sai de services.ts,
   o card acompanha sozinho. Ja aconteceu de a home anunciar oito disciplinas com
   nove cadastradas. */
const cards: Card[] = [
  {
    title: 'Projetos',
    tagline: 'Arquitetura, estrutura e instalações',
    summary:
      'Projeto técnico completo, com memorial de cálculo e detalhamento executivo, compatibilizado entre as disciplinas antes de ir para a obra.',
    bullets: primaryServices.map((s) => s.title),
    image: 'servico-projetos',
    icon: 'blueprint',
    href: '/servicos#projetos',
  },
  ...agencies.map((agency) => ({
    title: agency.name,
    tagline: agency.tagline,
    summary: agency.summary,
    bullets: agency.bullets,
    image: agency.image,
    icon: agency.icon,
    href: `/servicos/regularizacao/${agency.id}`,
  })),
];
---

<Section id="servicos" tone="offwhite" width="wide">
  <SectionTitle
    eyebrow="O que fazemos"
    title="Projeto, aprovação e <span class='text-orange-600'>regularização</span>"
    subtitle="Do desenho técnico ao documento na mão: projetamos, protocolamos e acompanhamos o processo nos três órgãos que a obra precisa atravessar."
  />

  <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      cards.map((card, i) => {
        const img = getImage(card.image);
        return (
          <article
            class="group flex flex-col overflow-hidden rounded-2xl bg-white shadow-card transition-all duration-400 ease-out hover:-translate-y-2 hover:shadow-card-hover"
            data-reveal
            style={`--reveal-delay:${i * 110}ms`}
          >
            <div class="relative aspect-[16/10] overflow-hidden bg-navy-900">
              <Image
                src={img.src}
                alt={img.alt}
                widths={[400, 700, 1100]}
                sizes="(min-width: 1024px) 300px, (min-width: 640px) 46vw, 92vw"
                class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                loading="lazy"
              />
              {/* Gradiente curto so na base: assenta o cartao sem apagar a foto,
                  que aqui e o que diferencia um card do outro. */}
              <div
                class="absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-navy-900/70 to-transparent"
                aria-hidden="true"
              />
              <span class="absolute bottom-4 left-4 flex h-12 w-12 items-center justify-center rounded-xl bg-orange-500 text-white shadow-lg transition-transform duration-300 group-hover:scale-110">
                <Icon name={card.icon} class="h-6 w-6" />
              </span>
            </div>

            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-xl leading-snug text-navy-900">{card.title}</h3>
              <p class="mt-1 text-sm font-semibold text-orange-600">{card.tagline}</p>
              <p class="mt-3 text-sm leading-relaxed text-navy-900/60">{card.summary}</p>

              <ul class="mt-5 space-y-2.5 border-t border-navy-900/8 pt-5">
                {card.bullets.map((b) => (
                  <li class="flex items-start gap-2.5 text-[0.8125rem] leading-snug text-navy-900/75">
                    <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-orange-500" />
                    {b}
                  </li>
                ))}
              </ul>

              {/* `mt-auto` cola o link na base mesmo com listas de tamanhos
                  diferentes — sao 9 disciplinas contra 3 itens da CETESB. */}
              <a
                href={card.href}
                class="mt-auto inline-flex cursor-pointer items-center gap-2 self-start pt-6 text-sm font-bold text-navy-800 transition-colors hover:text-orange-600"
              >
                Ver detalhes
                <Icon
                  name="arrow-right"
                  class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                />
              </a>
            </div>
          </article>
        );
      })
    }
  </div>

  <div class="mt-14 text-center" data-reveal>
    <Button href="/servicos" variant="primary" size="lg">
      Ver todos os serviços
      <Icon name="arrow-right" class="h-4 w-4" />
    </Button>
  </div>
</Section>
