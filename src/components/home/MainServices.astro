---
/**
 * "O que fazemos" — os quatro cards da home.
 *
 * O documento de ajustes R01 do cliente pediu explicitamente para reduzir este
 * bloco a quatro frentes: Projetos, Prefeitura, Bombeiros e CETESB, cada uma com
 * sua foto de capa e com o escopo listado dentro do card.
 *
 * As nove disciplinas de projeto sairam daqui e vivem agora em /servicos#projetos
 * — o card "Projetos" e a porta de entrada delas. O ganho e de leitura: nove
 * cards grandes na primeira rolagem faziam o visitante escanear sem ler nenhum,
 * e as tres frentes de orgao ficavam mais abaixo, competindo com o mesmo assunto.
 *
 * Os tres cards de orgao vem de `agencies` — a mesma fonte da secao Agencies
 * usada nas paginas internas. Nao ha texto duplicado entre os dois componentes,
 * so markup diferente para contextos diferentes.
 *
 * TRES DECISOES DE FORMA, todas pedidas na revisao de 11/08/2026:
 *
 * 1. O card estava alto demais. A capa subiu para 4:3 e o bloco de texto exibe
 *    so o essencial — titulo, linha de apoio e os primeiros itens do escopo.
 *
 * 2. O resto do escopo fica atras de um "Ver tudo". E um <details> nativo, sem
 *    JavaScript: funciona com o teclado, funciona antes de qualquer script
 *    carregar e o conteudo escondido continua no HTML, entao o buscador le tudo.
 *
 * 3. O card inteiro leva para a pagina — capa, titulo, area vazia. Feito com
 *    link esticado (o ::after do ancora cobre o article) em vez de envolver tudo
 *    num <a>, porque um <details> dentro de um link e HTML invalido e o clique
 *    para expandir acabaria navegando. O <details> sobe em z-index e fica acima
 *    dessa camada, que e o que separa "expandir" de "abrir a pagina".
 */
import { Image } from 'astro:assets';
import { agencies, type Agency } from '../../data/agencies';
import { primaryServices } from '../../data/services';
import { getImage } from '../../lib/images';
import Section from '../ui/Section.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Card {
  title: string;
  tagline: string;
  summary: string;
  bullets: string[];
  image: string;
  fit: 'cover' | 'contain';
  icon: 'blueprint' | Agency['icon'];
  href: string;
}

/* Quantos itens do escopo aparecem antes do "Ver tudo". Tres cabem sem alongar
   o card e ja dizem do que a frente trata. */
const VISIVEIS = 3;

/* O card de projetos lista as disciplinas a partir de `primaryServices`, e nao
   de uma lista escrita a mao: quando uma disciplina entra ou sai de services.ts,
   o card acompanha sozinho. Ja aconteceu de a home anunciar oito disciplinas com
   nove cadastradas. */
const cards: Card[] = [
  {
    title: 'Projetos',
    tagline: 'Arquitetura, estrutura e instalações',
    summary:
      'Projeto técnico completo, com memorial de cálculo e detalhamento executivo, compatibilizado entre as disciplinas antes de ir para a obra.',
    bullets: primaryServices.map((s) => s.title),
    image: 'servico-projetos',
    fit: 'cover',
    icon: 'blueprint',
    href: '/servicos#projetos',
  },
  ...agencies.map((agency) => ({
    title: agency.name,
    tagline: agency.tagline,
    summary: agency.summary,
    bullets: agency.bullets,
    image: agency.cover,
    fit: agency.coverFit,
    icon: agency.icon,
    href: `/servicos/regularizacao/${agency.id}`,
  })),
];
---

<Section id="servicos" tone="offwhite" width="wide">
  <SectionTitle
    eyebrow="O que fazemos"
    title="Projeto, aprovação e <span class='text-orange-600'>regularização</span>"
    subtitle="Do desenho técnico ao documento na mão: projetamos, protocolamos e acompanhamos o processo nos três órgãos que a obra precisa atravessar."
  />

  <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      cards.map((card, i) => {
        const img = getImage(card.image);
        const visiveis = card.bullets.slice(0, VISIVEIS);
        const ocultos = card.bullets.slice(VISIVEIS);

        return (
          <article
            class="group relative flex flex-col overflow-hidden rounded-2xl bg-white shadow-card transition-all duration-400 ease-out hover:-translate-y-2 hover:shadow-card-hover"
            data-reveal
            style={`--reveal-delay:${i * 110}ms`}
          >
            <div
              class:list={[
                'relative aspect-[4/3] overflow-hidden',
                /* Capa com logo precisa de fundo proprio e de uma divisa: sobre
                   branco puro ela se funde ao corpo do card e o cartao parece
                   ter perdido a imagem. `pb-16` reserva a faixa do selo do
                   icone, para o brasao centralizado nao encostar nele. */
                card.fit === 'contain'
                  ? 'border-b border-navy-900/10 bg-navy-900/[0.04] p-6 pb-16'
                  : 'bg-navy-900',
              ]}
            >
              <Image
                src={img.src}
                alt={img.alt}
                widths={[400, 700, 1100]}
                sizes="(min-width: 1024px) 300px, (min-width: 640px) 46vw, 92vw"
                class:list={[
                  'h-full w-full transition-transform duration-700 ease-out group-hover:scale-105',
                  card.fit === 'contain' ? 'object-contain' : 'object-cover',
                ]}
                loading="lazy"
              />

              {card.fit === 'cover' && (
                <div
                  class="absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-navy-900/70 to-transparent"
                  aria-hidden="true"
                />
              )}

              <span class="absolute bottom-4 left-4 flex h-12 w-12 items-center justify-center rounded-xl bg-orange-500 text-white shadow-lg transition-transform duration-300 group-hover:scale-110">
                <Icon name={card.icon} class="h-6 w-6" />
              </span>
            </div>

            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-xl leading-snug text-navy-900">{card.title}</h3>
              <p class="mt-1 text-sm font-semibold text-orange-600">{card.tagline}</p>

              <ul class="mt-4 space-y-2.5 border-t border-navy-900/8 pt-4">
                {visiveis.map((b) => (
                  <li class="flex items-start gap-2.5 text-[0.8125rem] leading-snug text-navy-900/75">
                    <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-orange-500" />
                    {b}
                  </li>
                ))}
              </ul>

              {/* `relative z-10` tira o <details> de baixo da camada clicavel do
                  link esticado. Sem isso, expandir navegaria. */}
              <details class="group/exp relative z-10 mt-3">
                <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded text-[0.8125rem] font-bold text-navy-800 transition-colors hover:text-orange-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500 [&::-webkit-details-marker]:hidden">
                  <span class="group-open/exp:hidden">Ver tudo</span>
                  <span class="hidden group-open/exp:inline">Ver menos</span>
                  <Icon
                    name="chevron-down"
                    class="h-3.5 w-3.5 transition-transform duration-300 group-open/exp:rotate-180"
                  />
                </summary>

                {ocultos.length > 0 && (
                  <ul class="mt-3 space-y-2.5">
                    {ocultos.map((b) => (
                      <li class="flex items-start gap-2.5 text-[0.8125rem] leading-snug text-navy-900/75">
                        <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-orange-500" />
                        {b}
                      </li>
                    ))}
                  </ul>
                )}

                <p class="mt-4 border-t border-navy-900/8 pt-4 text-sm leading-relaxed text-navy-900/60">
                  {card.summary}
                </p>
              </details>

              {/* Link esticado: o ::after nao tem `relative` no proprio ancora,
                  entao ele se ancora no <article> e cobre o card inteiro. */}
              <a
                href={card.href}
                class="mt-auto inline-flex cursor-pointer items-center gap-2 self-start pt-5 text-sm font-bold text-navy-800 transition-colors hover:text-orange-600 after:absolute after:inset-0 after:content-['']"
              >
                Ver detalhes
                <Icon
                  name="arrow-right"
                  class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                />
              </a>
            </div>
          </article>
        );
      })
    }
  </div>

  <div class="mt-14 text-center" data-reveal>
    <Button href="/servicos" variant="primary" size="lg">
      Ver todos os serviços
      <Icon name="arrow-right" class="h-4 w-4" />
    </Button>
  </div>
</Section>
