---
/**
 * Casca de toda pagina: <head>, metadados de SEO, JSON-LD e os slots de layout.
 *
 * Todo dado estruturado deriva de src/data/site.ts. Isso mantem o NAP (nome,
 * endereco, telefone) identico entre o JSON-LD, o rodape e a secao de mapa —
 * divergencia de NAP entre partes da pagina prejudica o ranqueamento local.
 */
import '../styles/global.css';
import { site } from '../data/site';
import { cities } from '../data/cities';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppFab from '../components/layout/WhatsAppFab.astro';

interface Props {
  title?: string;
  description?: string;
  /**
   * Palavras-chave da pagina.
   *
   * O Google ignora esta meta desde 2009; ela fica por dois motivos praticos:
   * outros buscadores e agregadores ainda a leem, e ter a lista explicita por
   * pagina obriga a decidir para que termo cada pagina existe — o que evita duas
   * paginas competindo pela mesma busca. O trabalho de SEO de verdade continua
   * sendo o texto, o title e o dado estruturado.
   */
  keywords?: readonly string[];
  /** Caminho da imagem de compartilhamento, relativo a raiz do site. */
  ogImage?: string;
  /**
   * Link do WhatsApp do botao flutuante. Serve para a pagina de campanha usar a
   * mensagem dela tambem no botao fixo, e nao so nos CTAs do corpo.
   */
  whatsappHref?: string;
}

const {
  title = site.seo.title,
  description = site.seo.description,
  keywords = site.seo.keywords,
  ogImage = '/og-image.jpg',
  whatsappHref,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = new URL(ogImage, Astro.site).href;

/**
 * Bloqueio de indexacao.
 *
 * Ligado por padrao: este build serve um subdominio de preview, e um preview
 * indexado vira conteudo duplicado competindo com o dominio definitivo, alem de
 * colocar a marca do cliente num dominio de terceiro nos resultados de busca.
 *
 * Desligar apenas no lancamento, com PUBLIC_NOINDEX=false.
 */
const noindex = import.meta.env.PUBLIC_NOINDEX !== 'false';
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${Astro.site}#organization`,
  name: site.name,
  legalName: site.legalName,
  description: site.shortDescription,
  url: Astro.site?.href,
  telephone: site.contact.phoneE164,
  email: site.contact.email,
  taxID: site.cnpj,
  image: ogUrl,
  logo: new URL('/favicon.png', Astro.site).href,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.zip,
    addressCountry: site.address.country,
  },
  // `geo` so entra quando as coordenadas estiverem confirmadas. Sem ele o Google
  // geocodifica pelo endereco postal; com coordenada errada, marcaria a empresa
  // no lugar errado. Ver a nota em src/data/site.ts.
  ...(site.address.geoConfirmed
    ? {
        geo: {
          '@type': 'GeoCoordinates',
          latitude: site.address.lat,
          longitude: site.address.lng,
        },
      }
    : {}),
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:00',
    closes: '18:00',
  },
  areaServed: cities.map((c) => ({
    '@type': 'City',
    name: c.name,
    addressRegion: 'SP',
    addressCountry: 'BR',
  })),
  knowsAbout: site.seo.keywords,
  sameAs: Object.values(site.social),
};
---

<!doctype html>
<html lang="pt-BR" class="no-js scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonical} />

    <meta name="author" content={site.legalName} />
    <meta name="robots" content={robots} />
    {noindex && <meta name="googlebot" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0a1c38" />
    <meta name="geo.region" content="BR-SP" />
    <meta name="geo.placename" content={`${site.address.district}, ${site.address.city}`} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    {/* Marca que o JS esta ativo antes da primeira pintura, para o conteudo
        animado nao piscar. Sem JS, a classe no-js mantem tudo visivel. */}
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="overflow-x-hidden">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-orange-500 focus:px-4 focus:py-2 focus:font-semibold focus:text-white"
    >
      Pular para o conteúdo
    </a>

    <Navbar />

    <main id="conteudo">
      <slot />
    </main>

    <Footer />
    <WhatsAppFab href={whatsappHref} />

    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
