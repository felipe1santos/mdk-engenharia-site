---
/**
 * Pagina de um orgao — Prefeitura, Corpo de Bombeiros ou CETESB.
 *
 * Fica sob /servicos/regularizacao porque e desdobramento daquele servico: a
 * pagina-mae explica a frente inteira, estas detalham cada balcao. A hierarquia
 * de URL comunica isso ao visitante e ao buscador, e concentra a autoridade no
 * caminho em vez de espalhar por tres paginas soltas na raiz.
 *
 * Dado estruturado: `Service` com `provider` apontando para a organizacao, mais
 * `FAQPage` com as perguntas e `BreadcrumbList` vindo do PageHero.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/layout/PageHero.astro';
import FinalCta from '../../../components/home/FinalCta.astro';
import Section from '../../../components/ui/Section.astro';
import Button from '../../../components/ui/Button.astro';
import Icon from '../../../components/ui/Icon.astro';
import { agencies } from '../../../data/agencies';
import { site, whatsappUrl } from '../../../data/site';
import { getImage } from '../../../lib/images';

export function getStaticPaths() {
  return agencies.map((agency) => ({
    params: { slug: agency.id },
    props: { agency },
  }));
}

const { agency } = Astro.props;
const { detail } = agency;
const img = getImage(agency.image);

const others = agencies.filter((a) => a.id !== agency.id);

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${agency.name} — ${agency.tagline}`,
  description: agency.seo.description,
  serviceType: agency.fullName,
  provider: { '@id': `${Astro.site}#organization` },
  areaServed: { '@type': 'AdministrativeArea', name: 'São Paulo e Região Metropolitana' },
  url: new URL(Astro.url.pathname, Astro.site).href,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `Serviços — ${agency.fullName}`,
    itemListElement: detail.services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.title, description: s.text },
    })),
  },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: detail.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title={agency.seo.title}
  description={agency.seo.description}
  keywords={agency.seo.keywords}
>
  <PageHero
    eyebrow={agency.fullName}
    title={agency.tagline}
    subtitle={agency.summary}
    crumbs={[
      { label: 'Serviços', href: '/servicos' },
      { label: 'Documentação e Regularização', href: '/servicos/regularizacao' },
      { label: agency.name },
    ]}
    image={agency.image}
  >
    <div class="mt-10 flex flex-col gap-4 sm:flex-row" data-reveal style="--reveal-delay:280ms">
      <Button href={whatsappUrl} variant="primary" size="lg" external>
        <Icon name="whatsapp" class="h-5 w-5" />
        Falar sobre o meu caso
      </Button>
      <Button href="/servicos/regularizacao" variant="outline" size="lg">
        Ver a frente completa
      </Button>
    </div>
  </PageHero>

  <Section tone="white" width="wide">
    <div class="grid gap-14 lg:grid-cols-[1.55fr_1fr] lg:gap-20">
      <div>
        <div class="space-y-5 text-lg leading-relaxed text-navy-900/75" data-reveal>
          {detail.intro.map((p) => <p>{p}</p>)}
        </div>

        <h2
          class="mt-14 flex items-center gap-3 font-display text-sm font-bold uppercase tracking-[0.14em] text-navy-900"
          data-reveal
        >
          <span class="h-px w-8 bg-orange-500" aria-hidden="true"></span>
          O que resolvemos
        </h2>

        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {
            detail.services.map((s, i) => (
              <li
                class="rounded-xl border border-navy-900/10 bg-offwhite p-6 transition-colors duration-300 hover:border-orange-500/40"
                data-reveal
                style={`--reveal-delay:${(i % 2) * 90}ms`}
              >
                <h3 class="text-base font-bold leading-snug text-navy-900">{s.title}</h3>
                <p class="mt-2.5 text-sm leading-relaxed text-navy-900/65">{s.text}</p>
              </li>
            ))
          }
        </ul>

        <h2
          class="mt-14 flex items-center gap-3 font-display text-sm font-bold uppercase tracking-[0.14em] text-navy-900"
          data-reveal
        >
          <span class="h-px w-8 bg-orange-500" aria-hidden="true"></span>
          Como o processo anda
        </h2>

        <ol class="mt-6 space-y-4">
          {
            detail.steps.map((s, i) => (
              <li class="flex gap-5" data-reveal style={`--reveal-delay:${i * 80}ms`}>
                <span
                  class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-navy-800 font-display text-sm font-bold text-orange-500"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                <div class="border-b border-navy-900/8 pb-4">
                  <h3 class="text-base font-bold text-navy-900">{s.title}</h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-navy-900/65">{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="mt-14" data-reveal>
          <h2 class="font-display text-2xl text-navy-900">Perguntas frequentes</h2>
          <div class="mt-6 divide-y divide-navy-900/10 border-y border-navy-900/10">
            {
              detail.faq.map((f) => (
                <details class="group py-5">
                  <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-base font-bold text-navy-900 transition-colors hover:text-orange-600">
                    {f.q}
                    <Icon
                      name="chevron-down"
                      class="mt-1 h-4 w-4 shrink-0 text-orange-500 transition-transform duration-300 group-open:rotate-180"
                    />
                  </summary>
                  <p class="mt-3 text-[0.9375rem] leading-relaxed text-navy-900/65">{f.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </div>

      <aside class="lg:sticky lg:top-28 lg:self-start">
        <div class="overflow-hidden rounded-2xl shadow-card" data-reveal>
          <Image
            src={img.src}
            alt={img.alt}
            widths={[400, 700, 1000]}
            sizes="(min-width: 1024px) 380px, 92vw"
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
          />
        </div>

        <div class="mt-6 rounded-2xl bg-offwhite p-7" data-reveal style="--reveal-delay:80ms">
          <h2 class="font-display text-sm font-bold uppercase tracking-[0.14em] text-navy-900">
            Para começar, tenha em mãos
          </h2>
          <ul class="mt-5 space-y-3">
            {
              detail.documents.map((d) => (
                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-navy-900/70">
                  <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-orange-500" />
                  {d}
                </li>
              ))
            }
          </ul>
        </div>

        <div
          class="mt-6 rounded-2xl border border-navy-900/10 p-7"
          data-reveal
          style="--reveal-delay:160ms"
        >
          <h2 class="font-display text-sm font-bold uppercase tracking-[0.14em] text-navy-900">
            Base legal e normas
          </h2>
          <ul class="mt-5 space-y-2.5 text-sm leading-relaxed text-navy-900/60">
            {detail.norms.map((n) => <li class="border-l-2 border-orange-500/40 pl-3">{n}</li>)}
          </ul>
        </div>

        <div
          class="mt-6 rounded-2xl bg-navy-800 p-7 text-white"
          data-reveal
          style="--reveal-delay:240ms"
        >
          <h2 class="font-display text-lg leading-snug">Não sabe em que situação está?</h2>
          <p class="mt-2.5 text-sm leading-relaxed text-white/65">
            Mande o endereço e o que existe hoje. O diagnóstico vem antes do orçamento.
          </p>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-orange-500 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-orange-400"
          >
            <Icon name="whatsapp" class="h-4 w-4" />
            Falar no WhatsApp
          </a>
          <p class="mt-4 text-center text-xs text-white/45">{site.contact.phoneDisplay}</p>
        </div>
      </aside>
    </div>
  </Section>

  <Section tone="offwhite" space="md" width="wide">
    <h2 class="font-display text-2xl text-navy-900" data-reveal>Outros órgãos</h2>
    <ul class="mt-8 grid gap-5 sm:grid-cols-2">
      {
        others.map((o, i) => (
          <li data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <a
              href={`/servicos/regularizacao/${o.id}`}
              class="group flex h-full cursor-pointer gap-5 rounded-2xl border border-navy-900/10 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-orange-500/40 hover:shadow-card"
            >
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-navy-800 text-orange-500 transition-colors duration-300 group-hover:bg-orange-500 group-hover:text-white">
                <Icon name={o.icon} class="h-5 w-5" />
              </span>
              <div>
                <h3 class="text-base leading-snug text-navy-900">{o.name}</h3>
                <p class="mt-1 text-sm leading-relaxed text-navy-900/60">{o.tagline}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <FinalCta />
</BaseLayout>

<script is:inline type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />
