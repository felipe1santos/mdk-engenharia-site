---
/**
 * /servicos/regularizacao/prefeitura/regularizacao-de-imovel
 * PAGINA DE VENDAS DE REGULARIZACAO DE IMOVEL.
 *
 * Primeira das paginas de assunto da frente de prefeitura. A pagina-mae
 * (`regularizacao/prefeitura.astro`) explica o balcao e distribui; esta fecha
 * contato sozinha, porque e o destino do trafego pago de "regularizar imovel",
 * "regularizacao imobiliaria" e "auto de regularizacao". As outras tres —
 * habite-se, aprovacao e alvara, desdobro de lote — viram paginas iguais a esta
 * conforme o cliente for abrindo campanha; o indice em
 * src/data/prefeitura-topics.ts ja esta preparado para receber a URL de cada uma.
 *
 * ESTRUTURA. Segue o esqueleto das duas referencias que o cliente mandou em
 * 13/09/2026 — nexxer.com.br e a LP da Fortezza Engenharia — porque as duas
 * funcionam e ele disse expressamente que gostou da segunda, "mais direta ao
 * ponto": reconhecimento de situacao, custo de nao resolver, metodo em etapas,
 * o que muda depois, prova, FAQ, contato. O que NAO veio junto foram os numeros.
 *
 * NENHUM PERCENTUAL FOI COPIADO, E ISSO E DELIBERADO. As duas referencias
 * afirmam coisas como "70% dos imoveis do Brasil sao irregulares", "seu imovel
 * pode valer ate 50% mais" e "de 60 a 120 dias". Nao ha fonte para nenhuma
 * delas, e numero inventado em pagina de servico de engenharia e risco duplo:
 * publicidade enganosa no CDC e, no Google Ads, motivo de reprovacao por
 * "afirmacoes nao comprovaveis". Onde a referencia poe percentual, esta pagina
 * poe a consequencia juridica concreta — que e verificavel e, para quem esta
 * com o negocio travado, mais convincente.
 *
 * PRAZO. Mesma regra: a pagina nao promete prazo fechado. Processo de prefeitura
 * depende do orgao e da complexidade do caso, e a unica promessa honesta e a de
 * diagnostico antes do orcamento — que e a que o cliente ja faz nas outras
 * paginas.
 *
 * ACERVO DE IMAGENS. Todas `imovel-*`, exclusivas desta pagina e da pagina-mae.
 * Vale aqui o veto que o cliente deu em 03/09/2026 na pagina de bombeiros:
 * pagina de campanha que repete a foto da home nao se distingue da home. A foto
 * vertical da equipe ao lado do texto e a copia do enquadramento da secao
 * "Expansao sem riscos" da Nexxer, que foi o pedido explicito.
 *
 * O WhatsApp usa mensagem propria, inclusive no botao flutuante: numa pagina que
 * recebe midia paga, o texto que chega escrito na conversa e o unico rastro que
 * separa esse lead do organico.
 */
import { Image } from 'astro:assets';
/* Lockup branco completo, como na capa de /servicos/regularizacao/bombeiros. A
   navbar usa a versao curta; numa capa de campanha cabe a marca por extenso. */
import logoFull from '../../../../assets/logo/mdk-logo-full-light.png';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Team from '../../../../components/home/Team.astro';
import FinalCta from '../../../../components/home/FinalCta.astro';
import Section from '../../../../components/ui/Section.astro';
import SectionTitle from '../../../../components/ui/SectionTitle.astro';
import Button from '../../../../components/ui/Button.astro';
import Icon from '../../../../components/ui/Icon.astro';
import { site, whatsappUrlFor, yearsInBusiness } from '../../../../data/site';
import { getImage } from '../../../../lib/images';

const wa = whatsappUrlFor(
  'Vim pelo site e quero regularizar meu imóvel. Posso mandar o endereço e o que existe construído?',
);

const capaImg = getImage('imovel-fachada-residencial');
/* A foto no formato da Nexxer: vertical, equipe tecnica em campo. */
const equipeImg = getImage('imovel-equipe-vistoria');
const levantamentoImg = getImage('imovel-levantamento-campo');
const pranchaImg = getImage('imovel-prancha-projeto');
const escrituraImg = getImage('imovel-escritura-assinatura');
const chavesImg = getImage('imovel-chaves-entrega');
const cidadeImg = getImage('imovel-sao-paulo-aerea');

const pageTitle = 'Regularização de Imóvel em São Paulo | Auto de Regularização e Averbação | MDK';
const pageDescription =
  'Regularização de imóvel construído sem alvará ou fora do projeto aprovado em São Paulo e Grande SP. Levantamento, projeto de regularização, protocolo na prefeitura e averbação em cartório. Diagnóstico antes do orçamento.';
const pageKeywords = [
  'regularização de imóvel',
  'regularizar imóvel São Paulo',
  'legalização imobiliária',
  'auto de regularização',
  'regularização de construção',
  'regularização de obra sem alvará',
  'averbação de construção em cartório',
  'regularização de imóvel para financiamento',
  'imóvel irregular o que fazer',
  'regularização de ampliação e edícula',
  'Lei 17.202/2019 regularização São Paulo',
  'engenheiro para regularizar imóvel Zona Norte',
];

const heroBullets = [
  'Levantamento do que existe construído hoje e diagnóstico do que a lei permite manter',
  'Projeto de regularização, protocolo na prefeitura e resposta às exigências até o auto sair',
  'Orientação da averbação em cartório — que é o que faz a área construída entrar na matrícula',
];

/* Fatos verificaveis, todos derivados de src/data/site.ts. Nenhum numero escrito
   a mao, entao nenhum envelhece sozinho — e nenhum e afirmacao de marketing. */
const provas = [
  { valor: `${yearsInBusiness} anos`, rotulo: `No mercado desde ${site.foundedYear}` },
  { valor: 'Engenharia própria', rotulo: 'Do levantamento à averbação' },
  { valor: '3 órgãos', rotulo: 'Prefeitura, Bombeiros e CETESB' },
  { valor: 'CNPJ', rotulo: site.cnpj },
];

/*
 * Reconhecimento de situacao — o bloco que a LP da Fortezza abre com "Isso
 * aconteceu com voce?".
 *
 * E o mais importante da pagina para midia paga. Quem clica no anuncio nao
 * procura "auto de regularizacao": procura resolver uma venda travada. A secao
 * existe para essa pessoa se achar em uma linha e clicar sem ler o resto.
 */
const situacoes = [
  {
    icon: 'document' as const,
    titulo: 'A venda travou na documentação',
    texto:
      'O comprador pediu a matrícula, e a área construída não consta lá. Sem averbação, o negócio para no cartório — e costuma ser descoberto com a proposta já aceita.',
  },
  {
    icon: 'building' as const,
    titulo: 'O banco recusou o financiamento',
    texto:
      'O banco trabalha com a matrícula, não com a realidade. Se a construção não está averbada, ela não entra na avaliação de garantia e o financiamento não sai.',
  },
  {
    icon: 'hammer' as const,
    titulo: 'Construí ou ampliei sem alvará',
    texto:
      'Edícula, segundo pavimento, área de serviço fechada, galpão nos fundos. Foi executado, funciona, e não existe em nenhum papel da prefeitura.',
  },
  {
    icon: 'shield' as const,
    titulo: 'Recebi notificação ou multa',
    texto:
      'A fiscalização autuou, embargou ou deu prazo. Aqui a ordem importa: responder o processo administrativo e regularizar são coisas diferentes, e precisam andar juntas.',
  },
  {
    icon: 'clipboard' as const,
    titulo: 'Recebi de herança e nada bate',
    texto:
      'Inventário aberto, planta antiga, imóvel reformado por três gerações. O inventário não fecha enquanto o que está na matrícula não corresponder ao que está de pé.',
  },
  {
    icon: 'factory' as const,
    titulo: 'Preciso do alvará de funcionamento',
    texto:
      'Ponto alugado, atividade pronta para abrir, e a prefeitura pede a documentação da edificação antes da licença. Sem imóvel regular, o negócio não abre.',
  },
];

/*
 * Custo de nao resolver.
 *
 * Cada item e consequencia juridica ou pratica verificavel — nao ha percentual
 * de desvalorizacao aqui, pela razao explicada no topo do arquivo.
 */
const riscos = [
  {
    titulo: 'O imóvel não vende pelo que vale',
    texto:
      'Comprador que precisa de financiamento fica de fora, e sobra quem paga à vista — que desconta justamente por saber disso. A irregularidade não tira o valor do imóvel, tira o comprador.',
  },
  {
    titulo: 'Multa, embargo e ordem de demolição',
    texto:
      'Obra sem licença é infração ao Código de Obras do município. A autuação pode vir a qualquer momento, e a exigência de desfazimento é prevista em lei — não é hipótese remota.',
  },
  {
    titulo: 'Nada que dependa da matrícula anda',
    texto:
      'Financiamento, inventário, partilha, garantia bancária e desmembramento passam pelo Registro de Imóveis. Enquanto a construção não estiver averbada, todos ficam parados.',
  },
  {
    titulo: 'O problema encarece com o tempo',
    texto:
      'Legislação muda, e o que hoje é regularizável pode deixar de ser. Cada obra nova feita por cima de uma irregularidade também aumenta o que vai precisar ser adequado depois.',
  },
];

/*
 * As quatro frentes do servico, no formato da secao "Expansao sem riscos" da
 * Nexxer: foto vertical a esquerda, texto e quatro cards curtos a direita.
 */
const frentes = [
  {
    sigla: 'Levantamento',
    titulo: 'Cadastral e arquitetônico',
    texto: 'Medição em campo de tudo que está construído, inclusive o que nunca foi projetado.',
  },
  {
    sigla: 'Viabilidade',
    titulo: 'Análise técnica e legal',
    texto: 'O que a lei vigente admite manter, o que exige adequação e o que não tem caminho.',
  },
  {
    sigla: 'Projeto',
    titulo: 'Peças de regularização',
    texto: 'Plantas, memorial, quadro de áreas e as ARTs/RRTs no padrão que o município exige.',
  },
  {
    sigla: 'Processo',
    titulo: 'Protocolo e exigências',
    texto: 'Condução do processo no órgão e resposta técnica a cada comunicado, até a emissão.',
  },
];

/* O metodo, etapa a etapa. E a secao "O Metodo Fortezza" — com o conteudo que a
   MDK de fato executa, e sem prazo prometido. */
const metodo = [
  {
    titulo: 'Diagnóstico',
    texto:
      'Lemos a matrícula, o espelho de IPTU e o que já foi aprovado, cruzamos com o zoneamento do lote e comparamos com o que está construído. É aqui que aparece se o caminho é regularização, adequação prévia ou aprovação nova — e se existe caminho.',
  },
  {
    titulo: 'Levantamento em campo',
    texto:
      'Visita técnica e medição do imóvel como ele está hoje. É o que transforma "acho que tem uns 180 metros" em quadro de áreas defensável diante do órgão.',
  },
  {
    titulo: 'Projeto de regularização',
    texto:
      'Montagem das peças técnicas no padrão do município, com memorial descritivo, quadro de áreas e responsabilidade técnica registrada em ART ou RRT.',
  },
  {
    titulo: 'Protocolo e exigências',
    texto:
      'Abertura do processo no sistema eletrônico da prefeitura, recolhimento de taxas e resposta a cada comunicado de exigência. É a etapa que mais alonga processo quando mal conduzida, e onde a experiência com o balcão pesa mais que o desenho.',
  },
  {
    titulo: 'Emissão e averbação',
    texto:
      'Saída do Auto de Regularização e orientação da averbação no Registro de Imóveis — o passo final, e o único que faz a construção existir na matrícula.',
  },
];

/* O que muda depois. Beneficios concretos, sem percentual. */
const ganhos = [
  {
    icon: 'check' as const,
    titulo: 'A matrícula passa a descrever o imóvel real',
    texto:
      'A área construída entra no Registro de Imóveis. É o que o comprador, o banco e o inventário consultam — e a partir daí todos enxergam o imóvel inteiro.',
  },
  {
    icon: 'building' as const,
    titulo: 'O comprador consegue financiar',
    texto:
      'Com a construção averbada, o imóvel volta a atender ao que o banco exige como garantia. O universo de compradores deixa de ser só quem paga à vista.',
  },
  {
    icon: 'shield' as const,
    titulo: 'Acaba a exposição a multa e embargo',
    texto:
      'Edificação regular não é passível de autuação por falta de licença. O risco sai do seu patrimônio e da sua agenda.',
  },
  {
    icon: 'document' as const,
    titulo: 'Destrava o que depende de documentação',
    texto:
      'Inventário, partilha, desmembramento, alvará de funcionamento, financiamento e uso do imóvel como garantia voltam a andar.',
  },
];

/* Tipos de imovel atendidos. Serve de reconhecimento e de cauda longa de busca:
   cada linha e uma consulta que alguem faz com essas palavras. */
const tipos = [
  { icon: 'building' as const, rotulo: 'Casa e sobrado' },
  { icon: 'hammer' as const, rotulo: 'Ampliação e edícula' },
  { icon: 'pillar' as const, rotulo: 'Prédio residencial' },
  { icon: 'factory' as const, rotulo: 'Galpão e indústria' },
  { icon: 'clipboard' as const, rotulo: 'Loja e comércio' },
  { icon: 'ruler' as const, rotulo: 'Terreno e lote' },
];

const documentosIniciais = [
  'Matrícula atualizada do imóvel',
  'IPTU ou espelho cadastral do lote',
  'Projeto anteriormente aprovado, se houver',
  'Documento de identificação do proprietário',
  'Notificação ou auto de infração, se já existir',
  'Fotos do que está construído hoje',
];

const normas = [
  'Lei Municipal 17.202/2019 — regularização de edificações no Município de São Paulo',
  'Lei Municipal 16.642/2017 — Código de Obras e Edificações de São Paulo',
  'Lei Municipal 16.402/2016 — Parcelamento, Uso e Ocupação do Solo de São Paulo',
  'Lei Federal 6.015/1973 — Registros Públicos, que rege a averbação da construção',
  'Lei Federal 13.465/2017 — regularização fundiária urbana (Reurb)',
  'NBR 13532 — elaboração de projetos de edificações: arquitetura',
  'NBR 9050 — acessibilidade, quando a edificação for de uso coletivo',
  'Legislação municipal específica, quando o imóvel ficar fora da capital',
];

const faq = [
  {
    q: 'Dá para regularizar qualquer imóvel?',
    a: 'Não. Construção sobre recuo obrigatório, em área não edificável, invadindo faixa de servidão ou acima do que o zoneamento admite pode não ter caminho sem adequação física — às vezes demolição parcial. O diagnóstico existe justamente para descobrir isso antes de um processo ser protocolado, e não depois de pago.',
  },
  {
    q: 'Quanto tempo demora?',
    a: 'Depende muito mais do órgão e da complexidade do caso do que do projeto. Processo simples, com o imóvel dentro do que a lei admite, corre mais rápido; caso que exige adequação física antes do protocolo leva o tempo da obra mais o do processo. Damos a estimativa depois do diagnóstico — antes disso, qualquer prazo seria chute.',
  },
  {
    q: 'Quanto custa?',
    a: 'O valor depende da área construída, da complexidade e de quanto do que existe precisa ser levantado do zero. Não trabalhamos com tabela fechada porque ela só funcionaria chutando para cima. O diagnóstico vem antes do orçamento, e o orçamento sai com escopo detalhado.',
  },
  {
    q: 'Qual a diferença entre regularizar e tirar o Habite-se?',
    a: 'O Habite-se, ou Certificado de Conclusão, é para obra que foi aprovada e executada conforme o projeto — ele só atesta a conclusão. A regularização é para obra que foi construída sem licença ou diferente do aprovado: ela cria a licença que nunca existiu. Se a obra saiu diferente do projeto, o caminho é regularizar primeiro.',
  },
  {
    q: 'Já tenho o auto da prefeitura. Está resolvido?',
    a: 'Falta a parte mais esquecida: a averbação. O documento da prefeitura autoriza, mas quem registra é o cartório. Enquanto a construção não for averbada na matrícula, para o banco e para o comprador o imóvel continua sendo só o terreno com o que estava registrado antes.',
  },
  {
    q: 'Posso vender enquanto regularizo?',
    a: 'Negociar, sim — é comum o processo correr em paralelo com a negociação, e às vezes com o comprador participando do custo. O que não dá é escriturar a construção antes de ela estar averbada. Vale combinar isso no contrato, e não descobrir na hora da assinatura.',
  },
  {
    q: 'Vocês atendem imóvel fora da capital?',
    a: 'Sim. Atendemos São Paulo e a Grande São Paulo. Em outro município muda a lei aplicável e o sistema de protocolo, não o roteiro do serviço — o diagnóstico já leva a legislação local em conta.',
  },
  {
    q: 'Preciso contratar a obra com vocês também?',
    a: 'Não. A regularização é um serviço fechado em si. Se o diagnóstico apontar adequação física necessária, apresentamos o escopo e você decide quem executa — podemos executar, acompanhar tecnicamente ou apenas especificar.',
  },
];

const relacionadas = [
  {
    href: '/servicos/regularizacao/prefeitura',
    icon: 'building' as const,
    titulo: 'Prefeitura',
    texto: 'A frente completa: alvará, Habite-se, desdobro e acessibilidade.',
  },
  {
    href: '/servicos/regularizacao/bombeiros',
    icon: 'flame' as const,
    titulo: 'Corpo de Bombeiros',
    texto: 'Projeto de incêndio, AVCB e CLCB — exigidos para imóvel comercial.',
  },
  {
    href: '/servicos/regularizacao/cetesb',
    icon: 'leaf' as const,
    titulo: 'CETESB',
    texto: 'Dispensa e licenciamento ambiental, quando a atividade exigir.',
  },
  {
    href: '/servicos/projeto-arquitetonico',
    icon: 'blueprint' as const,
    titulo: 'Projeto arquitetônico',
    texto: 'Para quem vai construir ou ampliar — aprovar antes é sempre mais barato.',
  },
];

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Regularização de imóvel em São Paulo',
  description: pageDescription,
  serviceType: 'Regularização de edificação junto à Prefeitura e averbação em cartório',
  provider: { '@id': `${Astro.site}#organization` },
  areaServed: { '@type': 'AdministrativeArea', name: 'São Paulo e Região Metropolitana' },
  url: new URL(Astro.url.pathname, Astro.site).href,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Etapas da regularização de imóvel',
    itemListElement: metodo.map((m) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: m.titulo, description: m.texto },
    })),
  },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

/* `HowTo` descreve o roteiro do servico para o buscador. Sem `totalTime`, pela
   mesma razao pela qual a pagina nao promete prazo. */
const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Como regularizar um imóvel em São Paulo',
  description:
    'Roteiro da regularização de uma construção executada sem alvará ou em desacordo com o projeto aprovado, do diagnóstico à averbação em cartório.',
  step: metodo.map((m, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: m.titulo,
    text: m.texto,
  })),
};

/* A trilha sai a mao: esta pagina nao usa PageHero, e e ele que emite o
   BreadcrumbList nas paginas internas. */
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { label: 'Home', href: '/' },
    { label: 'Serviços', href: '/servicos' },
    { label: 'Documentação e Regularização', href: '/servicos/regularizacao' },
    { label: 'Prefeitura', href: '/servicos/regularizacao/prefeitura' },
    { label: 'Regularização de imóvel' },
  ].map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: new URL(c.href, Astro.site).href } : {}),
  })),
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  whatsappHref={wa}
>
  {/* ─────────────────────────── HERO ───────────────────────────
      Capa diferente da de /servicos/regularizacao/bombeiros, de propósito. Lá a
      foto ocupa a metade direita e o texto fica sobre o navy sólido, porque a
      fotografia é técnica — placa de rota de fuga — e some sob cortina.

      Aqui o assunto é o imóvel inteiro, e a foto PRECISA ser lida como imóvel à
      primeira vista: é ela que diz em meio segundo do que a página trata. Então
      volta o formato de foto sangrada com cortina por cima, que é o da
      referência da Fortezza. A cortina é dupla e assimétrica — opaca à esquerda,
      onde fica o texto, e leve à direita, onde a casa aparece.

      `isolate` é obrigatório: sem contexto de empilhamento próprio, os filhos
      com z-index negativo escapam para a raiz e a foto some atrás do fundo navy. */}
  <section
    class="relative isolate flex min-h-[92svh] items-center overflow-hidden bg-navy-900 pb-20 pt-32 sm:pb-28 sm:pt-40"
  >
    <Image
      src={capaImg.src}
      alt={capaImg.alt}
      widths={[700, 1200, 1800]}
      sizes="100vw"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
    />

    <div
      class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-900 via-navy-900/85 to-navy-900/45"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-t from-navy-900 via-navy-900/20 to-navy-900/70"
      aria-hidden="true"
    >
    </div>

    <div
      class="absolute inset-0 -z-10 overflow-hidden"
      style="mask-image: radial-gradient(120% 100% at 20% 40%, #000 20%, transparent 80%); -webkit-mask-image: radial-gradient(120% 100% at 20% 40%, #000 20%, transparent 80%);"
      aria-hidden="true"
    >
      <div class="bg-grid animate-grid-drift absolute -inset-40 text-white/[0.06]"></div>
    </div>

    <div class="mx-auto w-full max-w-7xl px-5 sm:px-8">
      <nav aria-label="Trilha de navegação" data-reveal>
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-white/50">
          <li>
            <a href="/" class="cursor-pointer transition-colors hover:text-orange-400">Home</a>
          </li>
          <li class="flex items-center gap-2">
            <Icon name="chevron-down" class="h-3 w-3 -rotate-90 text-white/30" />
            <a href="/servicos" class="cursor-pointer transition-colors hover:text-orange-400">
              Serviços
            </a>
          </li>
          <li class="flex items-center gap-2">
            <Icon name="chevron-down" class="h-3 w-3 -rotate-90 text-white/30" />
            <a
              href="/servicos/regularizacao/prefeitura"
