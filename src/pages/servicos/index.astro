---
/**
 * Indice de servicos.
 *
 * Resolve o pedido do cliente de "trazer toda a gama e levar para outra pagina
 * ampliando os assuntos": aqui ficam todas as frentes, divididas entre projeto e
 * obra, cada uma linkando para a pagina propria.
 *
 * Nao repete os cards grandes da home de proposito. A home vende; este indice
 * orienta — quem chega aqui ja sabe que quer contratar e precisa achar a
 * disciplina certa rapido.
 *
 * O nucleo tecnico ganhou a prancha de cada disciplina (`withImage`) porque a
 * lista de nove itens em texto puro nao mostrava o que a MDK entrega — o
 * desenho faz esse trabalho melhor que qualquer resumo. As frentes de execucao
 * seguem compactas: la o que diferencia e o escopo, nao a peca grafica.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import Agencies from '../../components/home/Agencies.astro';
import FinalCta from '../../components/home/FinalCta.astro';
import Section from '../../components/ui/Section.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import Icon from '../../components/ui/Icon.astro';
import { primaryServices, secondaryServices, segments, services } from '../../data/services';
import { site } from '../../data/site';
import { getImage } from '../../lib/images';

/* Escrito por extenso a partir do dado, e nao fixo no texto: o numero de frentes
   ja mudou duas vezes e o subtitulo ficou mentindo silenciosamente. */
const NUMERAIS = [
  '',
  'Uma',
  'Duas',
  'Três',
  'Quatro',
  'Cinco',
  'Seis',
  'Sete',
  'Oito',
  'Nove',
  'Dez',
  'Onze',
  'Doze',
  'Treze',
  'Catorze',
  'Quinze',
  'Dezesseis',
];
const totalFrentes = NUMERAIS[services.length] ?? String(services.length);

const groups = [
  {
    id: 'projetos',
    eyebrow: 'Núcleo técnico',
    title: "Disciplinas de <span class='text-orange-600'>projeto</span>",
    subtitle:
      'Cada disciplina com escopo próprio, memorial de cálculo e detalhamento executivo — compatibilizadas entre si antes de irem para a obra.',
    items: primaryServices,
    withImage: true,
  },
  {
    id: 'execucao',
    eyebrow: 'Da documentação à entrega',
    title: "Execução, consultoria e <span class='text-orange-600'>documentação</span>",
    subtitle: `Obras e acompanhamento técnico nos segmentos ${segments
      .join(', ')
      .toLowerCase()}, além de toda a documentação para aprovar e regularizar.`,
    items: secondaryServices,
    withImage: false,
  },
];
---

<BaseLayout
  title={`Serviços | ${site.name}`}
  description="Projetos de arquitetura, estrutura, instalações hidráulicas e elétricas, SPCI, gases medicinais, drenagem e industriais, além de execução, consultoria e regularização de obras."
>
  <PageHero
    eyebrow="O que fazemos"
    title="Serviços de <span class='text-orange-500'>engenharia e arquitetura</span>"
    subtitle={`Da concepção do projeto à entrega da obra regularizada. ${totalFrentes} frentes de atuação, com responsabilidade técnica registrada.`}
    crumbs={[{ label: 'Serviços' }]}
  />

  {
    groups.map((group, gi) => (
      <Section
        id={group.id}
        tone={gi % 2 === 0 ? 'white' : 'offwhite'}
        width="wide"
      >
        <SectionTitle
          eyebrow={group.eyebrow}
          title={group.title}
          subtitle={group.subtitle}
        />

        <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {group.items.map((service, i) => {
            /* Ar-condicionado ainda nao tem prancha no acervo. Em vez de pegar
               emprestada a de outra disciplina — o que seria informacao falsa —
               o card cai no layout compacto, so com o icone. */
            const img = group.withImage && service.image ? getImage(service.image) : null;

            return (
              <li data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`}>
                <a
                  href={`/servicos/${service.id}`}
                  class="group flex h-full cursor-pointer flex-col overflow-hidden rounded-2xl border border-navy-900/10 bg-white transition-all duration-300 hover:-translate-y-1.5 hover:border-orange-500/40 hover:shadow-card-hover"
                >
                  {img && (
                    /* Prancha tecnica, nao foto: `object-contain` sobre branco.
                       O mesmo tratamento da home (MainServices) para que a
                       disciplina seja reconhecida nas duas paginas. */
                    <div class="relative aspect-[16/10] overflow-hidden border-b border-navy-900/8 bg-white">
                      <Image
                        src={img.src}
                        alt={img.alt}
                        widths={[400, 700, 1200]}
                        sizes="(min-width: 1024px) 380px, (min-width: 640px) 46vw, 92vw"
                        class="h-full w-full object-contain transition-transform duration-700 ease-out group-hover:scale-105"
                        loading="lazy"
                      />
                      <span class="absolute bottom-4 left-4 flex h-12 w-12 items-center justify-center rounded-xl bg-orange-500 text-white shadow-lg transition-transform duration-300 group-hover:scale-110">
                        <Icon name={service.icon} class="h-6 w-6" />
                      </span>
                    </div>
                  )}

                  <div class="flex flex-1 flex-col p-7">
                    {!img && (
                      <span class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-navy-800 text-orange-500 transition-colors duration-300 group-hover:bg-orange-500 group-hover:text-white">
                        <Icon name={service.icon} class="h-6 w-6" />
                      </span>
                    )}

                    <h3 class="text-lg leading-snug text-navy-900">{service.title}</h3>
                    <p class="mt-3 flex-1 text-sm leading-relaxed text-navy-900/60">
                      {service.summary}
                    </p>

                    <span class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-navy-800 transition-colors group-hover:text-orange-600">
                      Ver detalhes
                      <Icon
                        name="arrow-right"
                        class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                      />
                    </span>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </Section>
    ))
  }

  <Agencies tone="white" />

  <FinalCta />
</BaseLayout>
