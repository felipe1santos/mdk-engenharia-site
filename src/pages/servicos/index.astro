---
/**
 * /servicos — indice de servicos E pagina de destino do trafego pago.
 *
 * O cliente vai mandar os leads de campanha para ca (e o card "Projetos" do
 * bloco "O que fazemos" tambem aponta para o ancora #projetos). Isso muda o que
 * a pagina precisa fazer: alem de orientar quem procura a disciplina certa, ela
 * tem que fechar contato sozinha, sem depender de o visitante navegar para
 * /contato. Dai a pagina ter CTA de WhatsApp em cinco pontos, prova (equipe,
 * CNPJ, tempo de mercado) e um caminho de volta para a home no fim.
 *
 * O BOTAO DE WHATSAPP DAQUI USA MENSAGEM PROPRIA — "Vim pelo site e eu gostaria
 * de fazer um orcamento", pedida pelo cliente. Ela chega escrita na conversa e e
 * o unico rastro que separa lead de campanha de lead organico no atendimento.
 * Ver `whatsappUrlFor` em src/data/site.ts.
 *
 * O hero nao usa PageHero. As paginas internas tem a faixa navy com a foto ao
 * fundo, e o cliente apontou o problema: a cortina azul tapa a foto e o recorte
 * come a imagem. Aqui a foto ganha painel proprio, com `aspect-ratio` tirado dos
 * metadados do arquivo — assim ela aparece inteira, sem corte e sem cortina.
 *
 * A malha de vigas em 3D fica em src/scripts/beams.ts e e carregada por import
 * dinamico, so quando a secao chega perto e so em desktop. O motivo esta no
 * cabecalho daquele arquivo: numa pagina de campanha, peso de bundle sai em
 * conversao.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Agencies from '../../components/home/Agencies.astro';
import Team from '../../components/home/Team.astro';
import FinalCta from '../../components/home/FinalCta.astro';
import Section from '../../components/ui/Section.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import { primaryServices, secondaryServices, segments, services } from '../../data/services';
import { site, whatsappOrcamentoUrl, yearsInBusiness } from '../../data/site';
import { getImage } from '../../lib/images';

/* Escrito por extenso a partir do dado, e nao fixo no texto: o numero de frentes
   ja mudou duas vezes e o subtitulo ficou mentindo silenciosamente. */
const NUMERAIS = [
  '',
  'Uma',
  'Duas',
  'Três',
  'Quatro',
  'Cinco',
  'Seis',
  'Sete',
  'Oito',
  'Nove',
  'Dez',
  'Onze',
  'Doze',
  'Treze',
  'Catorze',
  'Quinze',
  'Dezesseis',
];
const totalFrentes = NUMERAIS[services.length] ?? String(services.length);

const heroImg = getImage('hero');
const destaqueImg = getImage('servico-projetos');
const execucaoImg = getImage('banner-servico-interno');

/* Fatos verificaveis, nao numeros de efeito. Cada um sai de src/data/ — nenhum
   foi escrito a mao aqui, entao nenhum envelhece sozinho. */
const provas = [
  { valor: `${yearsInBusiness} anos`, rotulo: `No mercado desde ${site.foundedYear}` },
  { valor: `${primaryServices.length}`, rotulo: 'Disciplinas de projeto' },
  { valor: '3', rotulo: 'Órgãos: Prefeitura, Bombeiros e CETESB' },
  { valor: `${segments.length}`, rotulo: segments.join(', ') },
];

const heroBullets = [
  'Projeto completo, com memorial de cálculo e detalhamento executivo',
  'Aprovação e regularização nos três órgãos, do protocolo ao documento',
  'Execução e consultoria com responsabilidade técnica registrada',
];

const passos = [
  {
    titulo: 'Você conta o que a obra precisa',
    texto: 'Endereço, tipo de imóvel, o que já existe e o que quer fazer. Plantas e fotos aceleram.',
  },
  {
    titulo: 'Analisamos as exigências do seu caso',
    texto: 'Verificamos o que a legislação pede e o que precisa entrar no escopo antes de orçar.',
  },
  {
    titulo: 'Recebe o orçamento por escrito',
    texto: 'O que está incluso, o que não está, o prazo e a forma de pagamento. Sem surpresa depois.',
  },
];
---

<BaseLayout
  title={`Serviços | ${site.name}`}
  description="Projetos de arquitetura, estrutura, instalações hidráulicas e elétricas, SPCI, gases medicinais, drenagem e industriais, além de execução, consultoria e regularização de obras."
  whatsappHref={whatsappOrcamentoUrl}
>
  {/* ─────────────────────────── HERO ─────────────────────────── */}
  <section class="relative isolate overflow-hidden bg-navy-900 pb-16 pt-28 sm:pb-24 sm:pt-36">
    <div
      class="absolute inset-0 -z-10 overflow-hidden"
      style="mask-image: radial-gradient(120% 100% at 20% 40%, #000 20%, transparent 80%); -webkit-mask-image: radial-gradient(120% 100% at 20% 40%, #000 20%, transparent 80%);"
      aria-hidden="true"
    >
      <div class="bg-grid animate-grid-drift absolute -inset-40 text-white/[0.06]"></div>
    </div>
    <div
      class="pointer-events-none absolute -right-24 -top-24 -z-10 h-96 w-96 rounded-full bg-orange-500/15 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto w-full max-w-7xl px-5 sm:px-8">
      <nav aria-label="Trilha de navegação" data-reveal>
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-white/50">
          <li><a href="/" class="cursor-pointer transition-colors hover:text-orange-400">Home</a></li>
          <li class="flex items-center gap-2">
            <Icon name="chevron-down" class="h-3 w-3 -rotate-90 text-white/30" />
            <span class="text-white/75">Serviços</span>
          </li>
        </ol>
      </nav>

      <div class="mt-10 grid items-center gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
        <div>
          <p
            class="inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-white/80"
            data-reveal
          >
            <span class="h-1.5 w-1.5 rounded-full bg-orange-500" aria-hidden="true"></span>
            Engenharia e Arquitetura em São Paulo
          </p>

          <h1
            class="mt-6 text-[2.25rem] leading-[1.1] text-white sm:text-5xl lg:text-[3.5rem]"
            data-reveal
            style="--reveal-delay:80ms"
          >
            Projeto, aprovação e obra <span class="text-orange-500">com um responsável só</span>
          </h1>

          <p
            class="mt-6 max-w-xl text-base leading-relaxed text-white/75 sm:text-lg"
            data-reveal
            style="--reveal-delay:140ms"
          >
            Da concepção do projeto à entrega da obra regularizada. {totalFrentes} frentes de atuação,
            com responsabilidade técnica registrada em cada etapa.
          </p>

          <ul class="mt-8 space-y-3" data-reveal style="--reveal-delay:200ms">
            {
              heroBullets.map((b) => (
                <li class="flex items-start gap-3 text-sm leading-relaxed text-white/85 sm:text-base">
                  <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-orange-500" />
                  {b}
                </li>
              ))
            }
          </ul>

          <div
            class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center"
            data-reveal
            style="--reveal-delay:260ms"
          >
            <Button href={whatsappOrcamentoUrl} variant="primary" size="lg" external>
              <Icon name="whatsapp" class="h-5 w-5" />
              Quero um orçamento
              <Icon
                name="arrow-right"
                class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
              />
            </Button>
            <Button href={`tel:${site.contact.phoneE164}`} variant="outline" size="lg">
              <Icon name="phone" class="h-5 w-5" />
              {site.contact.phoneDisplay}
            </Button>
          </div>

          <p class="mt-6 text-sm text-white/45" data-reveal style="--reveal-delay:320ms">
            {site.contact.hours} · Resposta mais rápida pelo WhatsApp
          </p>
        </div>

        {/*
          A foto em painel proprio resolve as duas queixas do cliente de uma vez:
          nao ha cortina azul por cima dela, e o `aspect-ratio` sai dos metadados
          do arquivo, entao `object-cover` nao tem o que cortar — a imagem aparece
          inteira, em qualquer largura.
        */}
        <div class="relative" data-reveal style="--reveal-delay:180ms">
          <div
            class="bg-dots pointer-events-none absolute -bottom-6 -right-6 h-40 w-40 text-orange-500/45 sm:h-52 sm:w-52"
            aria-hidden="true"
          >
          </div>
          <div
            class="pointer-events-none absolute -left-5 -top-5 h-24 w-24 rounded-full border-2 border-orange-500/35"
            aria-hidden="true"
          >
          </div>

          <div class="relative overflow-hidden rounded-3xl border border-white/10 shadow-2xl">
            <Image
              src={heroImg.src}
              alt={heroImg.alt}
              widths={[600, 900, 1400]}
              sizes="(min-width: 1024px) 560px, 92vw"
              class="w-full object-cover"
              style={`aspect-ratio:${heroImg.src.width}/${heroImg.src.height}`}
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ─────────────────────── FAIXA DE PROVA ─────────────────────── */}
  <Section tone="offwhite" space="sm" width="wide">
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        provas.map((p, i) => (
          <li
            class="flex items-baseline gap-3 border-l-2 border-orange-500 pl-4"
            data-reveal
            style={`--reveal-delay:${i * 90}ms`}
          >
            <span class="font-display text-2xl font-bold text-navy-900 sm:text-3xl">{p.valor}</span>
            <span class="text-sm leading-snug text-navy-900/60">{p.rotulo}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* ──────────────────── DISCIPLINAS DE PROJETO ──────────────────── */}
  <Section id="projetos" tone="white" width="wide" class="relative overflow-hidden">
    {/*
      Canto onde a malha de vigas e desenhada. Sem `data-beams` o script nao roda
      e este bloco fica vazio — nenhum layout depende dele. Escondido abaixo de
      lg, que e exatamente onde o script tambem desiste.
    */}
    <div
      class="pointer-events-none absolute -right-16 top-12 -z-0 hidden h-[26rem] w-[30rem] opacity-70 lg:block"
      data-beams
      aria-hidden="true"
    >
    </div>
    <div
      class="bg-dots pointer-events-none absolute -left-8 top-24 hidden h-56 w-40 text-orange-500/30 lg:block"
      aria-hidden="true"
    >
    </div>

    <div class="relative">
      <SectionTitle
        eyebrow="Núcleo técnico"
        title="Disciplinas de <span class='text-orange-600'>projeto</span>"
        subtitle="Cada disciplina com escopo próprio, memorial de cálculo e detalhamento executivo — compatibilizadas entre si antes de irem para a obra."
      />

      <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          primaryServices.map((service, i) => {
            /* Ar-condicionado ainda nao tem prancha no acervo. Em vez de pegar
               emprestada a de outra disciplina — o que seria informacao falsa —
               o card cai no layout compacto, so com o icone. */
            const img = service.image ? getImage(service.image) : null;

            return (
              <li data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`}>
                <a
                  href={`/servicos/${service.id}`}
                  class="group flex h-full cursor-pointer flex-col overflow-hidden rounded-2xl border border-navy-900/10 bg-white transition-all duration-300 hover:-translate-y-1.5 hover:border-orange-500/40 hover:shadow-card-hover"
                >
                  {img && (
                    /* Prancha tecnica, nao foto: `object-contain` sobre branco.
                       Recortar um desenho isometrico corta justamente a
                       informacao que ele carrega. */
                    <div class="relative aspect-[16/10] overflow-hidden border-b border-navy-900/8 bg-white">
                      <Image
                        src={img.src}
                        alt={img.alt}
                        widths={[400, 700, 1200]}
                        sizes="(min-width: 1024px) 380px, (min-width: 640px) 46vw, 92vw"
                        class="h-full w-full object-contain transition-transform duration-700 ease-out group-hover:scale-105"
                        loading="lazy"
                      />
                      <span class="absolute bottom-4 left-4 flex h-12 w-12 items-center justify-center rounded-xl bg-orange-500 text-white shadow-lg transition-transform duration-300 group-hover:scale-110">
                        <Icon name={service.icon} class="h-6 w-6" />
                      </span>
                    </div>
                  )}

                  <div class="flex flex-1 flex-col p-7">
                    {!img && (
                      <span class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-navy-800/5 text-navy-800 transition-colors duration-300 group-hover:bg-orange-500 group-hover:text-white">
                        <Icon name={service.icon} class="h-6 w-6" />
                      </span>
                    )}

                    <h3 class="text-lg leading-snug text-navy-900">{service.title}</h3>
                    <p class="mt-3 flex-1 text-sm leading-relaxed text-navy-900/60">
                      {service.summary}
                    </p>

                    <span class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-navy-800 transition-colors group-hover:text-orange-600">
                      Ver detalhes
                      <Icon
                        name="arrow-right"
                        class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                      />
                    </span>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>

      <div class="mt-12 text-center" data-reveal>
        <Button href={whatsappOrcamentoUrl} variant="primary" size="lg" external>
          <Icon name="whatsapp" class="h-5 w-5" />
          Falar sobre o meu projeto
        </Button>
      </div>
    </div>
  </Section>

  {/* ───────────── DESTAQUE: FOTO COM CARTAO SOBREPOSTO ─────────────
      `overflow-hidden` na secao porque a textura de pontos comeca 24 px a
      esquerda da foto: no mobile isso passa da margem do container e criaria
      rolagem horizontal na pagina inteira. */}
  <Section tone="offwhite" width="wide" class="overflow-hidden">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="relative" data-reveal>
        <div
          class="bg-dots pointer-events-none absolute -left-6 -top-6 h-40 w-40 text-orange-500/40"
          aria-hidden="true"
        >
        </div>

        <div class="relative overflow-hidden rounded-3xl shadow-card">
          <Image
            src={destaqueImg.src}
            alt={destaqueImg.alt}
            widths={[500, 800, 1100]}
            sizes="(min-width: 1024px) 520px, 92vw"
            class="w-full object-cover"
            style={`aspect-ratio:${destaqueImg.src.width}/${destaqueImg.src.height}`}
            loading="lazy"
          />
        </div>

        {/*
          O cartao invade a foto: fica dentro dela no desktop e volta para o
          fluxo, logo abaixo, no mobile — sobreposicao em tela estreita comeria a
          imagem inteira e espremeria o texto.
        */}
        <div
          class="mt-6 rounded-2xl border border-navy-900/10 bg-white p-6 shadow-card-hover sm:p-7 lg:absolute lg:-bottom-8 lg:-right-10 lg:mt-0 lg:max-w-xs"
        >
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-orange-500 text-white shadow-lg">
            <Icon name="blueprint" class="h-6 w-6" />
          </span>
          <p class="mt-4 font-display text-lg font-bold leading-snug text-navy-900">
            Projeto e obra na mesma mão
          </p>
          <p class="mt-2 text-sm leading-relaxed text-navy-900/60">
            Quem desenha responde pela execução. Não existe a conversa de que o problema foi do
            projeto ou da mão de obra.
          </p>
        </div>
      </div>

      <div class="lg:pl-4">
        <SectionTitle
          align="left"
          eyebrow="Como funciona"
          title="Do primeiro contato ao <span class='text-orange-600'>orçamento por escrito</span>"
          subtitle="Três passos, sem enrolação. Você fala com quem entende de obra, não com atendimento de script."
        />

        <ol class="mt-10 space-y-6">
          {
            passos.map((p, i) => (
              <li class="flex gap-5" data-reveal style={`--reveal-delay:${i * 110}ms`}>
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-navy-800 font-display text-base font-bold text-orange-400">
                  {i + 1}
                </span>
                <div>
                  <h3 class="text-base font-bold leading-snug text-navy-900">{p.titulo}</h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-navy-900/60">{p.texto}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="mt-10" data-reveal style="--reveal-delay:340ms">
          <Button href={whatsappOrcamentoUrl} variant="primary" size="lg" external>
            <Icon name="whatsapp" class="h-5 w-5" />
            Começar agora pelo WhatsApp
          </Button>
        </div>
      </div>
    </div>
  </Section>

  {/* ────────────── EXECUCAO, CONSULTORIA E DOCUMENTACAO ────────────── */}
  <Section id="execucao" tone="white" width="wide">
    <SectionTitle
      eyebrow="Da documentação à entrega"
      title="Execução, consultoria e <span class='text-orange-600'>documentação</span>"
      subtitle={`Obras e acompanhamento técnico nos segmentos ${segments
        .join(', ')
        .toLowerCase()}, além de toda a documentação para aprovar e regularizar.`}
    />

    {/* Quatro cards numa linha so a partir de lg, como o cliente pediu. Abaixo
        disso a linha unica espremeria o texto a ponto de nao dar para ler. */}
    <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        secondaryServices.map((service, i) => (
          <li data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <a
              href={`/servicos/${service.id}`}
              class="group relative flex h-full cursor-pointer flex-col overflow-hidden rounded-2xl border border-navy-900/10 bg-white p-6 transition-all duration-300 hover:-translate-y-1.5 hover:border-orange-500/40 hover:shadow-card-hover"
            >
              <span
                class="absolute inset-x-0 top-0 h-0.5 origin-left scale-x-0 bg-orange-500 transition-transform duration-400 ease-out group-hover:scale-x-100"
                aria-hidden="true"
              />
              <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-navy-800/5 text-navy-800 transition-colors duration-300 group-hover:bg-orange-500 group-hover:text-white">
                <Icon name={service.icon} class="h-5 w-5" />
              </span>
              <h3 class="mt-4 text-base leading-snug text-navy-900">{service.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-navy-900/60">{service.summary}</p>

              {service.bullets.length > 0 && (
                <ul class="mt-4 space-y-2 border-t border-navy-900/8 pt-4">
                  {service.bullets.map((b) => (
                    <li class="flex items-start gap-2 text-[0.8125rem] leading-snug text-navy-900/70">
                      <Icon name="check" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-orange-500" />
                      {b}
                    </li>
                  ))}
                </ul>
              )}

              <span class="mt-auto inline-flex items-center gap-2 pt-5 text-sm font-bold text-navy-800 transition-colors group-hover:text-orange-600">
                Ver detalhes
                <Icon
                  name="arrow-right"
                  class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* ──────────────────── FAIXA DE OBRA + CTA ──────────────────── */}
  <section class="relative overflow-hidden bg-navy-900">
    <Image
      src={execucaoImg.src}
      alt=""
      widths={[700, 1200, 1600]}
      sizes="100vw"
      class="absolute inset-0 h-full w-full object-cover opacity-45"
      loading="lazy"
      aria-hidden="true"
    />
    <div
      class="absolute inset-0 bg-gradient-to-r from-navy-900 via-navy-900/80 to-navy-900/35"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto w-full max-w-7xl px-5 py-20 sm:px-8 sm:py-24">
      <div class="max-w-2xl" data-reveal>
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-orange-400">Sem intermediário</p>
        <h2 class="mt-4 text-3xl leading-tight text-white sm:text-4xl">
          Uma obra, um responsável técnico
        </h2>
        <p class="mt-5 text-base leading-relaxed text-white/75 sm:text-lg">
          Projeto, aprovação nos órgãos e execução saem da mesma equipe. Menos gente no meio
          significa menos retrabalho, menos exigência devolvida e prazo que se cumpre.
        </p>
        <div class="mt-8">
          <Button href={whatsappOrcamentoUrl} variant="primary" size="lg" external>
            <Icon name="whatsapp" class="h-5 w-5" />
            Vim pelo site, quero um orçamento
          </Button>
        </div>
      </div>
    </div>
  </section>

  {/* ────────────────────── ORGAOS ────────────────────── */}
  <Agencies tone="offwhite" variant="logo" />

  {/* ────────────────────── EQUIPE ────────────────────── */}
  <Team />

  {/* ──────────────── IDENTIFICACAO DA EMPRESA ──────────────── */}
  <Section tone="offwhite" space="md" width="wide">
    <div
      class="rounded-2xl border border-navy-900/10 bg-white p-7 sm:p-9"
      data-reveal
    >
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-orange-600">Razão social</p>
          <p class="mt-2 text-sm leading-relaxed text-navy-900">{site.legalName}</p>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-orange-600">CNPJ</p>
          {/* Numero em corpo maior e tabular: e o dado que o lead copia para
              conferir a empresa antes de fechar. */}
          <p class="mt-2 font-display text-lg font-bold tabular-nums text-navy-900">{site.cnpj}</p>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-orange-600">Endereço</p>
          <p class="mt-2 text-sm leading-relaxed text-navy-900">
            {site.address.street} — {site.address.district}<br />
            {site.address.city}/{site.address.state}, CEP {site.address.zip}
          </p>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-orange-600">Contato</p>
          <a
            href={`tel:${site.contact.phoneE164}`}
            class="mt-2 block cursor-pointer text-sm font-semibold text-navy-900 transition-colors hover:text-orange-600"
          >
            {site.contact.phoneDisplay}
          </a>
          <a
            href={`mailto:${site.contact.email}`}
            class="mt-1 block cursor-pointer break-all text-sm text-navy-900/70 transition-colors hover:text-orange-600"
          >
            {site.contact.email}
          </a>
        </div>
      </div>
    </div>
  </Section>

  <FinalCta
    whatsappHref={whatsappOrcamentoUrl}
    title="Vamos orçar a sua obra?"
    text="Envie os dados da obra pelo WhatsApp e receba um orçamento com escopo detalhado e prazo definido."
  />

  {/* ──────────────── VOLTA PARA A HOME ──────────────── */}
  <Section tone="white" space="sm">
    <div class="flex flex-col items-center gap-4 text-center" data-reveal>
      <p class="text-sm text-navy-900/60">
        Quer conhecer a MDK antes de falar com a gente?
      </p>
      <Button href="/" variant="ghost" size="lg">
        <Icon name="arrow-left" class="h-4 w-4" />
        Ir para a página inicial
      </Button>
    </div>
  </Section>
</BaseLayout>

