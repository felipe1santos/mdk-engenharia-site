---
/**
 * Pagina de uma disciplina.
 *
 * Gerada a partir de src/data/services.ts. `getStaticPaths` filtra por `detail`:
 * servico sem conteudo redigido nao ganha rota, o que evita publicar pagina
 * vazia so para existir link — pagina fina ranqueia mal e ainda derruba a
 * avaliacao das outras.
 *
 * O dado estruturado sai como `Service` e, quando ha perguntas, tambem como
 * `FAQPage` — e o que habilita o bloco de perguntas no resultado de busca.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import Agencies from '../../components/home/Agencies.astro';
import FinalCta from '../../components/home/FinalCta.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import { detailedServices, services } from '../../data/services';
import { site, whatsappUrl } from '../../data/site';
import { getImage } from '../../lib/images';

export function getStaticPaths() {
  return detailedServices.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const detail = service.detail!;
const img = service.image ? getImage(service.image) : null;

/** Outras frentes da mesma categoria, para nao terminar a pagina em beco sem saida. */
const related = services
  .filter((s) => s.id !== service.id && s.category === service.category && s.detail)
  .slice(0, 3);

const pageTitle = service.seo?.title ?? `${service.title} | ${site.name}`;
const pageDescription = service.seo?.description ?? service.summary;

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: pageDescription,
  serviceType: service.title,
  provider: { '@id': `${Astro.site}#organization` },
  areaServed: { '@type': 'AdministrativeArea', name: 'São Paulo e Região Metropolitana' },
  url: new URL(Astro.url.pathname, Astro.site).href,
};

const faqLd = detail.faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: detail.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

<BaseLayout title={pageTitle} description={pageDescription} keywords={service.seo?.keywords}>
  <PageHero
    eyebrow={service.category === 'projeto' ? 'Disciplina de projeto' : 'Obra e documentação'}
    title={service.title}
    subtitle={service.summary}
    crumbs={[{ label: 'Serviços', href: '/servicos' }, { label: service.title }]}
  >
    <div class="mt-10 flex flex-col gap-4 sm:flex-row" data-reveal style="--reveal-delay:280ms">
      <Button href={whatsappUrl} variant="primary" size="lg" external>
        <Icon name="whatsapp" class="h-5 w-5" />
        Solicitar orçamento
      </Button>
      <Button href="/servicos" variant="outline" size="lg">Ver todos os serviços</Button>
    </div>
  </PageHero>

  <Section tone="white" width="wide">
    <div class="grid gap-14 lg:grid-cols-[1.6fr_1fr] lg:gap-20">
      <!-- Conteudo -->
      <div>
        <div class="space-y-5 text-lg leading-relaxed text-navy-900/75" data-reveal>
          {detail.intro.map((p) => <p>{p}</p>)}
        </div>

        {
          detail.scope.map((group, i) => (
            <div class="mt-12" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <h2 class="flex items-center gap-3 font-display text-sm font-bold uppercase tracking-[0.14em] text-navy-900">
                <span class="h-px w-8 bg-orange-500" aria-hidden="true" />
                {group.title}
              </h2>
              <ul class="mt-5 grid gap-3 sm:grid-cols-2">
                {group.items.map((item) => (
                  <li class="flex items-start gap-2.5 text-[0.9375rem] leading-relaxed text-navy-900/70">
                    <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-orange-500" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        {
          detail.faq && detail.faq.length > 0 && (
            <div class="mt-16" data-reveal>
              <h2 class="font-display text-2xl text-navy-900">Perguntas frequentes</h2>
              <div class="mt-6 divide-y divide-navy-900/10 border-y border-navy-900/10">
                {detail.faq.map((f) => (
                  <details class="group py-5">
                    <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-base font-bold text-navy-900 transition-colors hover:text-orange-600">
                      {f.q}
                      <Icon
                        name="chevron-down"
                        class="mt-1 h-4 w-4 shrink-0 text-orange-500 transition-transform duration-300 group-open:rotate-180"
                      />
                    </summary>
                    <p class="mt-3 text-[0.9375rem] leading-relaxed text-navy-900/65">{f.a}</p>
                  </details>
                ))}
              </div>
            </div>
          )
        }
      </div>

      <!-- Coluna lateral -->
      <aside class="lg:sticky lg:top-28 lg:self-start">
        {
          img && (
            <div
              class="overflow-hidden rounded-2xl border border-navy-900/10 bg-white"
              data-reveal
            >
              <Image
                src={img.src}
                alt={img.alt}
                widths={[400, 700, 1200]}
                sizes="(min-width: 1024px) 380px, 92vw"
                class="aspect-[16/10] w-full object-contain"
                loading="lazy"
              />
            </div>
          )
        }

        <div
          class="mt-6 rounded-2xl bg-offwhite p-7"
          data-reveal
          style="--reveal-delay:80ms"
        >
          <h2 class="font-display text-sm font-bold uppercase tracking-[0.14em] text-navy-900">
            O que você recebe
          </h2>
          <ul class="mt-5 space-y-3">
            {
              detail.deliverables.map((d) => (
                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-navy-900/70">
                  <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-orange-500" />
                  {d}
                </li>
              ))
            }
          </ul>
        </div>

        {
          detail.norms && detail.norms.length > 0 && (
            <div
              class="mt-6 rounded-2xl border border-navy-900/10 p-7"
              data-reveal
              style="--reveal-delay:160ms"
            >
              <h2 class="font-display text-sm font-bold uppercase tracking-[0.14em] text-navy-900">
                Normas aplicáveis
              </h2>
              <ul class="mt-5 space-y-2.5 text-sm leading-relaxed text-navy-900/60">
                {detail.norms.map((n) => (
                  <li class="border-l-2 border-orange-500/40 pl-3">{n}</li>
                ))}
              </ul>
            </div>
          )
        }

        <div
          class="mt-6 rounded-2xl bg-navy-800 p-7 text-white"
          data-reveal
          style="--reveal-delay:240ms"
        >
          <h2 class="font-display text-lg leading-snug">Tem um projeto em vista?</h2>
          <p class="mt-2.5 text-sm leading-relaxed text-white/65">
            Conte o que sua obra precisa e receba um orçamento com escopo e prazo definidos.
          </p>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-orange-500 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-orange-400"
          >
            <Icon name="whatsapp" class="h-4 w-4" />
            Falar no WhatsApp
          </a>
          <p class="mt-4 text-center text-xs text-white/45">{site.contact.phoneDisplay}</p>
        </div>
      </aside>
    </div>
  </Section>

  {/* Documentacao e Regularizacao e a unica frente que se desdobra por orgao;
      os tres cards entram aqui para que a pagina-mae abra caminho para eles. */}
  {
    service.id === 'regularizacao' && (
      <Agencies
        tone="offwhite"
        eyebrow="Órgão por órgão"
        title="Onde cada processo <span class='text-orange-600'>é protocolado</span>"
        subtitle="As exigências mudam conforme o balcão. Veja o que resolvemos em cada um."
      />
    )
  }

  {
    related.length > 0 && (
      <Section tone={service.id === 'regularizacao' ? 'white' : 'offwhite'} space="md" width="wide">
        <h2 class="font-display text-2xl text-navy-900" data-reveal>
          Outras frentes
        </h2>
        <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((r, i) => (
            <li data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <a
                href={`/servicos/${r.id}`}
                class="group flex h-full cursor-pointer flex-col rounded-2xl border border-navy-900/10 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-orange-500/40 hover:shadow-card"
              >
                <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-navy-800/5 text-navy-800 transition-colors duration-300 group-hover:bg-orange-500 group-hover:text-white">
                  <Icon name={r.icon} class="h-5 w-5" />
                </span>
                <h3 class="mt-4 text-base leading-snug text-navy-900">{r.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-navy-900/60">{r.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <FinalCta />
</BaseLayout>

<script is:inline type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
{faqLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
