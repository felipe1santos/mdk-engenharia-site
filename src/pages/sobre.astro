---
/**
 * Pagina institucional.
 *
 * Reaproveita os componentes da home (About, Team, StatsBand) em vez de
 * duplicar markup: o texto vive em src/data/institutional.ts e team.ts, entao
 * as duas paginas nunca divergem. A diferenca esta na ancora de `About`, que
 * aqui responde por #historia — o item que o cliente pediu no menu.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/layout/PageHero.astro';
import About from '../components/home/About.astro';
import Team from '../components/home/Team.astro';
import StatsBand from '../components/home/StatsBand.astro';
import FinalCta from '../components/home/FinalCta.astro';
import Section from '../components/ui/Section.astro';
import Icon from '../components/ui/Icon.astro';
import { site, yearsInBusiness } from '../data/site';
import { primaryServices, segments } from '../data/services';

const marks = [
  {
    icon: 'calendar',
    title: `Desde ${site.foundedYear}`,
    text: `${yearsInBusiness} anos de mercado em engenharia e construção civil.`,
  },
  {
    icon: 'building',
    title: 'Três segmentos',
    text: `Obras ${segments.join(', ').toLowerCase()}, do projeto à entrega.`,
  },
  {
    icon: 'blueprint',
    title: 'Projeto completo',
    /* Contado a partir do dado: o texto dizia "Oito" com nove disciplinas
       cadastradas em services.ts. */
    text: `${primaryServices.length} disciplinas de projeto compatibilizadas entre si.`,
  },
  {
    icon: 'document',
    title: 'Documentação',
    text: 'Prefeitura, Corpo de Bombeiros e CETESB, do protocolo ao Habite-se.',
  },
] as const;
---

<BaseLayout
  title={`Sobre a ${site.name} | Engenharia e Arquitetura em São Paulo`}
  description={`${site.legalName}: empresa de engenharia e arquitetura especializada em obras residenciais, comerciais e industriais, fundada em ${site.foundedYear}. Conheça a história, os valores e a direção técnica.`}
>
  <PageHero
    eyebrow="Sobre nós"
    title="Engenharia que sustenta <span class='text-orange-500'>grandes obras</span>"
    subtitle={`Fundada em ${site.foundedYear}, a ${site.name} atua com projetos e construção, com qualidade e foco nas necessidades de cada cliente.`}
    crumbs={[{ label: 'Sobre nós' }]}
    image="banner-sobre"
  >
    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        marks.map((m, i) => (
          <li
            class="rounded-xl border border-white/10 bg-white/[0.04] p-5"
            data-reveal
            style={`--reveal-delay:${300 + i * 80}ms`}
          >
            <Icon name={m.icon} class="h-5 w-5 text-orange-500" />
            <h2 class="mt-3 font-display text-sm font-bold text-white">{m.title}</h2>
            <p class="mt-1.5 text-sm leading-relaxed text-white/55">{m.text}</p>
          </li>
        ))
      }
    </ul>
  </PageHero>

  <About id="historia" />
  <Team />
  <StatsBand />

  <Section tone="offwhite" space="md">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <h2 class="font-display text-2xl text-navy-900">Razão social e registro</h2>
      <dl class="mt-8 grid gap-6 text-left sm:grid-cols-2">
        <div class="rounded-xl border border-navy-900/10 bg-white p-6">
          <dt class="text-[0.6875rem] font-bold uppercase tracking-[0.14em] text-navy-900/45">
            Razão social
          </dt>
          <dd class="mt-2 text-sm leading-relaxed text-navy-900/75">{site.legalName}</dd>
        </div>
        <div class="rounded-xl border border-navy-900/10 bg-white p-6">
          <dt class="text-[0.6875rem] font-bold uppercase tracking-[0.14em] text-navy-900/45">
            CNPJ
          </dt>
          <dd class="mt-2 text-sm leading-relaxed text-navy-900/75">{site.cnpj}</dd>
        </div>
      </dl>
    </div>
  </Section>

  <FinalCta />
</BaseLayout>
