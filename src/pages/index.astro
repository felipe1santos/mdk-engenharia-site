---
/**
 * Home da MDK Engenharia.
 *
 * A secao Agencies nao aparece mais aqui: os tres orgaos foram absorvidos pelo
 * bloco "O que fazemos" (MainServices), como o cliente pediu no documento R01.
 * Ela continua existindo e sendo usada nas paginas internas, onde o contexto
 * ainda pede a divisao por balcao.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import TrustBar from '../components/home/TrustBar.astro';
import MainServices from '../components/home/MainServices.astro';
import SecondaryServices from '../components/home/SecondaryServices.astro';
import About from '../components/home/About.astro';
import Team from '../components/home/Team.astro';
import StatsBand from '../components/home/StatsBand.astro';
import Portfolio from '../components/home/Portfolio.astro';
import Renders from '../components/home/Renders.astro';
import Testimonials from '../components/home/Testimonials.astro';
import ServiceAreas from '../components/home/ServiceAreas.astro';
import MapSection from '../components/home/MapSection.astro';
import FinalCta from '../components/home/FinalCta.astro';
---

<BaseLayout>
  <Hero />
  <TrustBar />
  <MainServices />
  <SecondaryServices />
  <About />
  <Team />
  <StatsBand />
  <Portfolio showAll />
  <Renders />
  <Testimonials />
  <ServiceAreas />
  <MapSection />
  <FinalCta />
</BaseLayout>
